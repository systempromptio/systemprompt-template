{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id AS \"id!: ProjectId\",\n            p.name AS \"name!\",\n            p.description,\n            COALESCE(m.member_count, 0)::BIGINT AS \"member_count!\"\n        FROM projects p\n        LEFT JOIN (\n            SELECT project_id, COUNT(*) AS member_count\n            FROM user_projects GROUP BY project_id\n        ) m ON m.project_id = p.id\n        ORDER BY p.name\n        ",
