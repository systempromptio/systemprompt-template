  "query": "\n            SELECT status as \"status!\", SUM(execution_count)::bigint as \"status_count!\"\n            FROM report_tool_usage_hourly\n            WHERE bucket >= date_trunc('hour', $1::timestamptz, 'UTC') AND bucket < $2 AND tool_name ILIKE $3\n            GROUP BY status\n            ORDER BY 2 DESC\n            ",
