  "query": "\n            SELECT\n                COUNT(*)::bigint as \"request_count!\",\n                COALESCE(SUM(tokens_used), 0)::bigint as \"total_tokens!\",\n                COALESCE(SUM(cost_microdollars), 0)::float8 / 1000000.0 as \"total_cost!\",\n                AVG(tokens_used)::float8 as \"avg_tokens_per_request\"\n            FROM ai_requests\n            WHERE user_id = $1\n            ",
