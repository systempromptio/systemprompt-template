  "query": "\n        SELECT module as \"module!\", SUM(log_count)::BIGINT as \"count\"\n        FROM log_rollup_hourly\n        WHERE ($1::TIMESTAMPTZ IS NULL OR bucket >= date_trunc('hour', $1, 'UTC'))\n        GROUP BY module\n        ORDER BY count DESC\n        LIMIT $2\n        ",
