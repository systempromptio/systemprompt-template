  "query": "\n            SELECT status as \"status!\", COUNT(*)::bigint as \"status_count!\"\n            FROM report_agent_tasks\n            WHERE agent_name ILIKE $1\n              AND started_at >= $2 AND started_at < $3\n            GROUP BY status\n            ORDER BY 2 DESC\n            ",
