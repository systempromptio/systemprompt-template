  "query": "SELECT b.owner_id,b.execution_id,b.fencing_token,b.traffic_class,x.fencing_token AS current_fence,x.status,(x.lease_expires_at>NOW() AND x.deadline_at>NOW()) AS live,e.status AS experiment_status,e.budget_id,e.spec->'variants'->x.variant_index->>'model' AS model,e.spec->'variants'->x.variant_index->>'provider' AS provider,EXISTS(SELECT 1 FROM eval_workers w WHERE w.id=x.lease_owner AND w.owner_id=e.owner_id AND w.enabled AND w.expires_at>NOW()) AS worker_live FROM eval_session_bindings b JOIN eval_executions x ON x.id=b.execution_id JOIN eval_experiments e ON e.id=x.experiment_id WHERE b.session_id=$1",
