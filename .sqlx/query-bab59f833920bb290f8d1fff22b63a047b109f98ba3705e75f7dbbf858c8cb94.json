{
  "db_name": "PostgreSQL",
  "query": "SELECT d.source_ref,d.source_type,d.title,d.uri,t.body,d.content_hash,COALESCE(d.mtime,d.indexed_at)::text AS \"version!\" FROM knowledge_documents d JOIN knowledge_source_text t ON t.doc_id=d.doc_id AND t.content_hash=d.content_hash WHERE d.doc_id>$2 AND d.source_type IN ('jira','confluence') AND EXISTS(SELECT 1 FROM knowledge_document_grants g WHERE g.doc_id=d.doc_id AND g.subject_kind='user' AND g.subject_value=$1) ORDER BY d.doc_id LIMIT $3",
