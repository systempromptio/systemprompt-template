  "query": "INSERT INTO user_settings (user_id, display_name, avatar_url, timezone, updated_at)\n           VALUES ($1, $2, $3, $4, NOW())\n           ON CONFLICT (user_id) DO UPDATE\n             SET display_name = EXCLUDED.display_name,\n                 avatar_url   = EXCLUDED.avatar_url,\n                 timezone     = EXCLUDED.timezone,\n                 updated_at   = NOW()\n           RETURNING\n             user_id AS \"user_id!: UserId\",\n             display_name,\n             avatar_url,\n             timezone,\n             created_at,\n             updated_at",
