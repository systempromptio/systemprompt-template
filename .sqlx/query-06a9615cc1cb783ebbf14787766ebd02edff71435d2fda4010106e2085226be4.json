{
  "db_name": "PostgreSQL",
  "query": "SELECT\n             s.session_id AS \"session_id!: SessionId\",\n             s.user_id AS \"user_id?: UserId\",\n             s.status AS \"status!\",\n             s.created_at AS \"created_at!\",\n             s.last_activity_at AS \"last_activity_at!\",\n             s.expires_at AS \"expires_at!\",\n             (s.user_id IS NOT NULL AND s.expires_at > NOW()) AS \"has_proxy_identity!\",\n             NULL::TEXT AS \"proxy_user_type?\"\n           FROM mcp_sessions s\n          WHERE s.mcp_server_id = $1\n          ORDER BY s.last_activity_at DESC\n          LIMIT $2",
