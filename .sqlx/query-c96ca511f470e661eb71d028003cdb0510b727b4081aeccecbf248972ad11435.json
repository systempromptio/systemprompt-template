{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id,s.hypothesis,s.status,s.proposed_changes,s.originating_evidence FROM eval_suggestions s WHERE s.owner_id=$1 AND s.experiment_id=$2 AND NOT EXISTS(SELECT 1 FROM unnest(s.supporting_execution_ids) AS supporting(execution_id) LEFT JOIN eval_executions x ON x.id=supporting.execution_id LEFT JOIN eval_experiments e ON e.id=x.experiment_id LEFT JOIN eval_resource_revisions c ON c.id=x.case_revision_id AND c.owner_id=e.owner_id WHERE e.owner_id IS DISTINCT FROM s.owner_id OR e.id IS DISTINCT FROM s.experiment_id OR c.content->'content'->>'partition' IS DISTINCT FROM 'development') ORDER BY s.created_at,s.id LIMIT 100",
