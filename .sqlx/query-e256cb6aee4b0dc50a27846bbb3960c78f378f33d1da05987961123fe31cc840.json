  "query": "SELECT source_type,file_id AS \"file_id: FileId\",project_id,project_name,folder_path,status,\n        COALESCE(metadata->>'name','') AS \"file_name!\",COALESCE(metadata->>'mimeType','') AS \"mime_type!\",\n        COALESCE(metadata->>'webViewLink','https://drive.google.com/file/d/' || file_id || '/view') AS \"uri!\",error FROM knowledge_drive_files WHERE source_type=$1 AND file_id>$2 ORDER BY file_id LIMIT $3",
