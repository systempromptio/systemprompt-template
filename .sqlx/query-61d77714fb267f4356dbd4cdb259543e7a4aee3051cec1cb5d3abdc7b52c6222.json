  "query": "SELECT\n               s.session_id AS \"session_id!: SessionId\",\n               s.started_at,\n               s.last_activity_at,\n               s.expires_at,\n               s.revoked_at,\n               s.session_source,\n               s.ip_address,\n               s.user_agent,\n               s.request_count\n           FROM user_sessions s\n           WHERE s.user_id = $1\n           ORDER BY s.last_activity_at DESC\n           LIMIT 200",
