  "query": "\n            UPDATE ai_gateway_thought_signatures\n            SET expires_at = NOW() + make_interval(secs => $3)\n            WHERE conversation_id = $1\n              AND tool_use_id = ANY($2)\n              AND user_id = $4\n              AND expires_at > NOW()\n            RETURNING tool_use_id, signature\n            ",
