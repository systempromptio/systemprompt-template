  "query": "\n                SELECT\n                    started_at as \"started_at!\",\n                    status,\n                    execution_time_ms\n                FROM report_agent_tasks\n                WHERE started_at >= $1 AND started_at < $2\n                  AND agent_name ILIKE $3\n                ORDER BY started_at\n                ",
