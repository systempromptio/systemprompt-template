  "query": "\n                SELECT\n                    created_at as \"created_at!\",\n                    status,\n                    execution_time_ms\n                FROM report_mcp_tool_executions\n                WHERE created_at >= $1 AND created_at < $2 AND tool_name ILIKE $3\n                ORDER BY created_at\n                ",
