{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ProfileType",
      "default": "local"
    },
    "site": {
      "$ref": "#/$defs/SiteConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "paths": {
      "$ref": "#/$defs/PathsConfig"
    },
    "security": {
      "$ref": "#/$defs/SecurityConfig"
    },
    "rate_limits": {
      "$ref": "#/$defs/RateLimitsConfig"
    },
    "system_admin": {
      "$ref": "#/$defs/SystemAdminConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "environment": "development",
        "log_level": "normal",
        "output_format": "text",
        "no_color": false,
        "non_interactive": false
      }
    },
    "cloud": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "secrets": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecretsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionsConfig",
      "default": {
        "disabled": []
      }
    },
    "governance": {
      "anyOf": [
        {
          "$ref": "#/$defs/GovernanceConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "judge": {
      "$ref": "#/$defs/JudgeProfile",
      "default": {
        "automatic": false
      }
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig",
      "default": {
        "logs_days": 30,
        "analytics_events_days": 90,
        "ai_request_messages_days": null,
        "mcp_tool_executions_days": 365,
        "outbox_processed_days": 7,
        "ai_request_payload_raw_days": 7,
        "governance_decisions_days": 180,
        "archived_users_days": 90
      }
    },
    "services": {
      "$ref": "#/$defs/ServicesProfileConfig",
      "default": {
        "port_offset": 0,
        "sources": [],
        "cache_dir": null,
        "on_fetch_failure": "use_last_good"
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "backend": "local",
        "shared": false,
        "public_read": false,
        "path_style": false
      }
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "otlp": null,
        "log_format": "text"
      }
    },
    "config_planes": {
      "$ref": "#/$defs/ConfigPlanesConfig",
      "default": {
        "authority": {}
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "display_name",
    "site",
    "database",
    "server",
    "paths",
    "security",
    "rate_limits",
    "system_admin"
  ],
  "$defs": {
    "ProfileType": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "SiteConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "github_link": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "DatabaseConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "external_db_access": {
          "type": "boolean",
          "default": false
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "migrate_on_boot": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "PoolConfig": {
      "description": "Operator-tunable connection-pool sizing.\n\nOmitted fields fall back to the engine defaults (50 connections, 30s\nacquire, 300s idle, 1800s lifetime); set them to fit the pool to the\ndeployment's Postgres `max_connections` and replica count.\n`statement_cache_capacity` defaults to 100 prepared statements per\nconnection. 0 is accepted but leaks: sqlx still names every statement and\nnever closes one without a cache, so each backend grows until Postgres runs\nout of memory.\n\n`max_connections_by_role` overrides `max_connections` for the node's\n`server.role`, so one profile can size a horizontally scaled gateway pool\nsmall and the single admin node's pool larger. A Postgres primary must\nadmit `gateway_replicas × (gateway pool + 2) + admin × (admin pool + 2)`\nplus migration and operator sessions; the `+ 2` are the replica-identity\nclaim and the event listener sessions every node holds.\n`session_max_connections` sizes the separate session pool a\n`database_session_url` opens (10 by default): it holds only the claim,\nlistener, job-lock and migration sessions, so it never needs the main\npool's ceiling.\n[`crate::profile::Profile::validate`] range-checks the values at bootstrap.",
      "type": "object",
      "properties": {
        "max_connections": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "acquire_timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_lifetime_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "statement_cache_capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_connections_by_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleMaxConnections"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_max_connections": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RoleMaxConnections": {
      "description": "Per-`server.role` pool ceilings; an omitted role uses\n[`PoolConfig::max_connections`].",
      "type": "object",
      "properties": {
        "all": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "gateway": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "admin": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "runner": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "api_server_url": {
          "type": "string"
        },
        "api_internal_url": {
          "type": "string"
        },
        "api_external_url": {
          "type": "string"
        },
        "use_https": {
          "type": "boolean",
          "default": false
        },
        "cors_allowed_origins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "content_negotiation": {
          "$ref": "#/$defs/ContentNegotiationConfig",
          "default": {
            "enabled": false,
            "markdown_suffix": ".md"
          }
        },
        "security_headers": {
          "$ref": "#/$defs/SecurityHeadersConfig",
          "default": {
            "enabled": true,
            "hsts": "max-age=63072000; includeSubDomains; preload",
            "frame_options": "DENY",
            "content_type_options": "nosniff",
            "referrer_policy": "strict-origin-when-cross-origin",
            "permissions_policy": "camera=(), microphone=(), geolocation=()",
            "content_security_policy": null
          }
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "metrics_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": null
        },
        "max_concurrent_streams": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 256
        },
        "role": {
          "$ref": "#/$defs/NodeRole",
          "default": "all"
        },
        "max_in_flight": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1,
          "default": null
        },
        "trusted_proxies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "shutdown": {
          "$ref": "#/$defs/ShutdownConfig",
          "default": {
            "pre_stop_delay_secs": 0,
            "drain_grace_secs": 10,
            "child_grace_secs": 5,
            "background_grace_secs": 5,
            "forced_exit_grace_secs": 10
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "api_server_url",
        "api_internal_url",
        "api_external_url"
      ]
    },
    "ContentNegotiationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "markdown_suffix": {
          "type": "string",
          "default": ".md"
        }
      },
      "additionalProperties": false
    },
    "SecurityHeadersConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "hsts": {
          "type": "string",
          "default": "max-age=63072000; includeSubDomains; preload"
        },
        "frame_options": {
          "type": "string",
          "default": "DENY"
        },
        "content_type_options": {
          "type": "string",
          "default": "nosniff"
        },
        "referrer_policy": {
          "$ref": "#/$defs/ReferrerPolicy",
          "default": "strict-origin-when-cross-origin"
        },
        "permissions_policy": {
          "type": "string",
          "default": "camera=(), microphone=(), geolocation=()"
        },
        "content_security_policy": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ReferrerPolicy": {
      "description": "`Referrer-Policy` directive. A closed set — an unknown value in the\nprofile is a load error rather than a header the browser silently ignores.",
      "type": "string",
      "enum": [
        "no-referrer",
        "no-referrer-when-downgrade",
        "origin",
        "origin-when-cross-origin",
        "same-origin",
        "strict-origin",
        "strict-origin-when-cross-origin",
        "unsafe-url"
      ]
    },
    "NodeRole": {
      "description": "The part of the platform a node serves.\n\n`all` is a single-node deployment: every surface, every worker, and the\nextensions' runner services, so one node runs the whole product.\n`gateway` serves only the AI gateway,\nthe bridge consumer surface and the OAuth/discovery routes they depend on,\nand runs no scheduler, MCP or agent processes, so it scales horizontally.\n`admin` serves everything except the gateway and runs the workers.\n`runner` serves only the health, readiness and metrics probes, runs no\nscheduler, MCP or agent processes, and starts the extensions' runner\nservices, so long-running work scales on its own Deployment.",
      "type": "string",
      "enum": [
        "all",
        "gateway",
        "admin",
        "runner"
      ]
    },
    "ShutdownConfig": {
      "description": "Shutdown deadlines in seconds. The defaults are the historical fixed\nwindows: no pre-stop delay, a 10 s drain, 5 s for children and background\nwork, and a 10 s forced-exit backstop.",
      "type": "object",
      "properties": {
        "pre_stop_delay_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "drain_grace_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "child_grace_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5
        },
        "background_grace_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5
        },
        "forced_exit_grace_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        }
      },
      "additionalProperties": false
    },
    "PathsConfig": {
      "description": "Filesystem roots for one profile.\n\n`shipped_files` is an optional read-only directory holding the files an\nimage ships under `files/` (CSS, JS, fonts, downloads). `/files/*` reads\n`paths.storage/files` first and falls back to it, so `paths.storage` only\nhas to hold user data and nothing has to be copied onto it at boot.",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "services": {
          "type": "string"
        },
        "bin": {
          "type": "string"
        },
        "web_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "storage": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "geoip_database": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "shipped_files": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "system",
        "services",
        "bin"
      ]
    },
    "SecurityConfig": {
      "type": "object",
      "properties": {
        "jwt_issuer": {
          "type": "string"
        },
        "jwt_access_token_expiration": {
          "type": "integer",
          "format": "int64"
        },
        "jwt_refresh_token_expiration": {
          "type": "integer",
          "format": "int64"
        },
        "jwt_audiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JwtAudience"
          }
        },
        "allowed_resource_audiences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow_registration": {
          "type": "boolean",
          "default": false
        },
        "allow_dynamic_client_registration": {
          "type": "boolean",
          "default": false
        },
        "login_page_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "signing_key_path": {
          "type": "string",
          "default": "signing_key.pem"
        },
        "trusted_issuers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrustedIssuer"
          }
        },
        "id_jag_ttl_secs": {
          "type": "integer",
          "format": "int64",
          "default": 300
        },
        "api_keys": {
          "$ref": "#/$defs/ApiKeyPolicyConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "jwt_issuer",
        "jwt_access_token_expiration",
        "jwt_refresh_token_expiration",
        "jwt_audiences"
      ]
    },
    "JwtAudience": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "web",
            "api",
            "a2a",
            "mcp",
            "internal",
            "bridge",
            "hook"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "TrustedIssuer": {
      "description": "A federated identity provider trusted for the RFC 8693 token-exchange and\nEMA (Enterprise-Managed Authorization) paths.\n\n`audience` holds the value the `IdP` places in `id_token.aud`; for a\nSalesforce Connected App that is its `client_id`, **not** a URL.",
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "jwks_uri": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "typ_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_client_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "can_issue_id_jag": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "issuer",
        "jwks_uri",
        "audience"
      ]
    },
    "ApiKeyPolicyConfig": {
      "description": "Issuance policy for personal access tokens (`security.api_keys`).\n\nWith `max_lifetime_days` set, every issuance path bounds the key: an\nomitted expiry becomes the maximum and a longer one is refused. Unset\nleaves keys without a lifetime ceiling.",
      "type": "object",
      "properties": {
        "max_lifetime_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RateLimitsConfig": {
      "description": "Per-route-group request budgets, in requests per second.\n\nEach `*_per_second` field governs one route group:\n\n- `oauth_public` — `/api/v1/core/oauth` public endpoints,\n  `/auth/link-passkey`, and the public gateway session routes under\n  `/api/public/gateway`.\n- `oauth_auth` — the authenticated half of `/api/v1/core/oauth`, plus\n  `/api/v1/core/users`.\n- `contexts` — `/api/v1/core/contexts` and the inbound `/api/v1/webhook`\n  mount.\n- `tasks` — `/api/v1/core/tasks`.\n- `artifacts` — `/api/v1/core/artifacts`.\n- `agent_registry` — `/api/v1/agents/registry`, discovery only, kept apart\n  from `agents_per_second` so listing agents cannot spend an execution\n  budget.\n- `agents` — `/api/v1/agents` execution, and the Slack and Teams inbound\n  mounts that dispatch to an agent.\n- `mcp_registry` — `/api/v1/mcp/registry`, the MCP server catalog, discovery\n  only.\n- `mcp` — `/api/v1/mcp` tool calls, the busiest protocol route group.\n- `stream` — `/api/v1/stream`, long-lived SSE connections, so this is a\n  connection budget rather than a request one and is set high.\n- `content` — `/api/v1/content`, `/api/v1/sync`, `/api/v1/marketplace`,\n  `/api/v1/analytics` and `/track/engagement`.\n- `gateway` — inference traffic under `/v1`: `/v1/messages` and the\n  OpenAI-shaped `/v1/chat/completions`.\n- `bridge_auth` — `/v1/auth/bridge/*`, deliberately separate from\n  `gateway_per_second`: sign-in is low-volume and must stay reachable on an\n  instance whose inference traffic is saturating its own budget. Sharing one\n  bucket let a busy gateway lock every user out of authenticating.\n\n`per_second_budgets` projects those fields as a list; both validators\niterate it rather than naming the fields themselves, which had already let\nthem drift apart and let a zero in an unnamed field through.",
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "oauth_public_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "oauth_auth_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "contexts_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "tasks_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "artifacts_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "agent_registry_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "agents_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 20
        },
        "mcp_registry_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "mcp_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 200
        },
        "stream_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "content_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "gateway_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "bridge_auth_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 20
        },
        "burst_multiplier": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "SystemAdminConfig": {
      "description": "Profile-supplied configuration for the platform owner. Must resolve at\nstartup to an active user row carrying the `admin` role; the platform\nrefuses to boot otherwise.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "username"
      ]
    },
    "RuntimeConfig": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "#/$defs/Environment",
          "default": "development"
        },
        "log_level": {
          "$ref": "#/$defs/LogLevel",
          "default": "normal"
        },
        "output_format": {
          "$ref": "#/$defs/OutputFormat",
          "default": "text"
        },
        "no_color": {
          "type": "boolean",
          "default": false
        },
        "non_interactive": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
