    "StorageConfig": {
      "description": "Where user-visible files are written and whether the root is shared\nbetween replicas.\n\n`backend: local` writes under `paths.storage`; `shared: true` declares\nthat root is a mount every replica can see, and boot warns when the\ndeclaration and the observed mount disagree. `backend: gcs` writes to\n`bucket` under `prefix`; `bucket`, `prefix`, `public_read` and\n`credentials` apply to it and to `s3` (gcs credentials default to\nworkload identity; s3 requires a secret). `backend: s3` also reads\n`endpoint` (default: AWS for `region`), `region` (default `us-east-1`)\nand `path_style` (required by most self-hosted S3 implementations).",
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/StorageBackend",
          "default": "local"
        },
        "shared": {
          "type": "boolean",
          "default": false
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_read": {
          "type": "boolean",
          "default": false
        },
        "credentials": {
          "anyOf": [
            {
              "$ref": "#/$defs/GcsCredentials"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "path_style": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "StorageBackend": {
      "type": "string",
      "enum": [
        "local",
        "gcs",
        "s3"
      ]
    },
    "GcsCredentials": {
      "description": "How an object-store backend authenticates.\n\nFor `gcs`, `workload_identity` asks the GCE/GKE metadata server for the\ntoken of the service account bound to the workload; `{ secret: NAME }` signs\nwith a service-account key JSON held in the secrets store under `NAME`. For\n`s3` only `{ secret: NAME }` applies, naming a JSON object with\n`access_key_id`, `secret_access_key` and an optional `session_token`.",
      "anyOf": [
        {
          "$ref": "#/$defs/CredentialsLiteral"
        },
        {
          "type": "object",
          "properties": {
            "secret": {
              "type": "string"
            }
          },
          "required": [
            "secret"
          ]
        }
      ]
    },
    "CredentialsLiteral": {
      "type": "string",
      "enum": [
        "workload_identity"
      ]
    },
