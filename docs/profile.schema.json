    "AuditConfig": {
      "description": "Retention bounds for the gateway audit trail.",
      "type": "object",
      "properties": {
        "payload_cap_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1048576
        }
      },
      "additionalProperties": false
    },
    "QuotaConfig": {
      "description": "Row sharding for gateway quota windows.\n\nA window keyed by a shared subject (anything other than `user` or\n`api_key`, e.g. an organization or project) is spread over\n`shared_subject_shards` rows so concurrent admissions do not queue on one\nrow lock; per-principal windows use `principal_subject_shards`. Admission\nstill checks the summed total, but each extra shard widens the\nover-admission bound by up to one concurrent reservation. `1` keeps the\nexact single-row behaviour. Both are range-checked by\n[`crate::profile::Profile::validate`].",
      "type": "object",
      "properties": {
        "shared_subject_shards": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 8
        },
        "principal_subject_shards": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "JudgeProfile": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RetentionConfig": {
      "description": "Retention windows, in days, for the high-volume operational tables.\n\nEach field names the table it bounds and rows older than the window are\ndeleted, with two exceptions worth knowing:\n\n- `ai_request_messages_days` drops the stored messages and keeps the request\n  row; `None` follows `ai.history.retention_days` from the services\n  configuration instead.\n- `ai_request_payload_raw_days` sets the raw request and response bodies on\n  `ai_request_payloads` to NULL rather than deleting the row; the excerpts,\n  hashes and sizes stay.\n- `archived_users_days` is how long an archived user (status `deleted`,\n  `archived_at` set) stays restorable before `database_cleanup` purges the\n  account and its rows; an account under legal hold is never purged.",
      "type": "object",
      "properties": {
        "logs_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 30
        },
        "analytics_events_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 90
        },
        "ai_request_messages_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "mcp_tool_executions_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 365
        },
        "outbox_processed_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 7
        },
        "ai_request_payload_raw_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 7
        },
        "governance_decisions_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 180
        },
        "archived_users_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 90
        }
      },
      "additionalProperties": false
    },
