{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ProfileType",
      "default": "local"
    },
    "site": {
      "$ref": "#/$defs/SiteConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "paths": {
      "$ref": "#/$defs/PathsConfig"
    },
    "security": {
      "$ref": "#/$defs/SecurityConfig"
    },
    "rate_limits": {
      "$ref": "#/$defs/RateLimitsConfig"
    },
    "system_admin": {
      "$ref": "#/$defs/SystemAdminConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "environment": "development",
        "log_level": "normal",
        "output_format": "text",
        "no_color": false,
        "non_interactive": false
      }
    },
    "cloud": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "secrets": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecretsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionsConfig",
      "default": {
        "disabled": []
      }
    },
    "governance": {
      "anyOf": [
        {
          "$ref": "#/$defs/GovernanceConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "judge": {
      "$ref": "#/$defs/JudgeProfile",
      "default": {
        "automatic": false
      }
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig",
      "default": {
        "logs_days": 30,
        "analytics_events_days": 90,
        "ai_request_messages_days": null,
        "mcp_tool_executions_days": 365,
        "outbox_processed_days": 7,
        "ai_request_payload_raw_days": 7,
        "governance_decisions_days": 180
      }
    },
    "services": {
      "$ref": "#/$defs/ServicesProfileConfig",
      "default": {
        "port_offset": 0,
        "sources": [],
        "cache_dir": null,
        "on_fetch_failure": "use_last_good"
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "backend": "local",
        "shared": false
      }
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "otlp": null
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "display_name",
    "site",
    "database",
    "server",
    "paths",
    "security",
    "rate_limits",
    "system_admin"
  ],
  "$defs": {
    "ProfileType": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "SiteConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "github_link": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "DatabaseConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "external_db_access": {
          "type": "boolean",
          "default": false
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "PoolConfig": {
      "description": "Operator-tunable connection-pool sizing.\n\nOmitted fields fall back to the engine defaults (50 connections, 30s\nacquire, 300s idle, 1800s lifetime); set them to fit the pool to the\ndeployment's Postgres `max_connections` and replica count.\n[`crate::profile::Profile::validate`] range-checks the values at bootstrap.",
      "type": "object",
      "properties": {
        "max_connections": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "acquire_timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_lifetime_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "api_server_url": {
          "type": "string"
        },
        "api_internal_url": {
          "type": "string"
        },
        "api_external_url": {
          "type": "string"
        },
        "use_https": {
          "type": "boolean",
          "default": false
        },
        "cors_allowed_origins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "content_negotiation": {
          "$ref": "#/$defs/ContentNegotiationConfig",
          "default": {
            "enabled": false,
            "markdown_suffix": ".md"
          }
        },
        "security_headers": {
          "$ref": "#/$defs/SecurityHeadersConfig",
          "default": {
            "enabled": true,
            "hsts": "max-age=63072000; includeSubDomains; preload",
            "frame_options": "DENY",
            "content_type_options": "nosniff",
            "referrer_policy": "strict-origin-when-cross-origin",
            "permissions_policy": "camera=(), microphone=(), geolocation=()",
            "content_security_policy": null
          }
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "metrics_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": null
        },
        "max_concurrent_streams": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 256
        },
        "trusted_proxies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "api_server_url",
        "api_internal_url",
        "api_external_url"
      ]
    },
    "ContentNegotiationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "markdown_suffix": {
          "type": "string",
          "default": ".md"
        }
      },
      "additionalProperties": false
    },
    "SecurityHeadersConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "hsts": {
          "type": "string",
          "default": "max-age=63072000; includeSubDomains; preload"
        },
        "frame_options": {
          "type": "string",
          "default": "DENY"
        },
        "content_type_options": {
          "type": "string",
          "default": "nosniff"
        },
        "referrer_policy": {
          "$ref": "#/$defs/ReferrerPolicy",
          "default": "strict-origin-when-cross-origin"
        },
        "permissions_policy": {
          "type": "string",
          "default": "camera=(), microphone=(), geolocation=()"
        },
        "content_security_policy": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ReferrerPolicy": {
      "description": "`Referrer-Policy` directive. A closed set — an unknown value in the\nprofile is a load error rather than a header the browser silently ignores.",
      "type": "string",
      "enum": [
        "no-referrer",
        "no-referrer-when-downgrade",
        "origin",
        "origin-when-cross-origin",
        "same-origin",
        "strict-origin",
        "strict-origin-when-cross-origin",
        "unsafe-url"
      ]
    },
    "PathsConfig": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "services": {
          "type": "string"
        },
        "bin": {
          "type": "string"
        },
        "web_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "storage": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "geoip_database": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "system",
        "services",
        "bin"
      ]
    },
    "SecurityConfig": {
      "type": "object",
      "properties": {
        "jwt_issuer": {
          "type": "string"
        },
        "jwt_access_token_expiration": {
          "type": "integer",
          "format": "int64"
        },
        "jwt_refresh_token_expiration": {
          "type": "integer",
          "format": "int64"
        },
        "jwt_audiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JwtAudience"
          }
        },
        "allowed_resource_audiences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allow_registration": {
          "type": "boolean",
          "default": true
        },
        "allow_dynamic_client_registration": {
          "type": "boolean",
          "default": true
        },
        "login_page_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "signing_key_path": {
          "type": "string",
          "default": "signing_key.pem"
        },
        "trusted_issuers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrustedIssuer"
          }
        },
        "id_jag_ttl_secs": {
          "type": "integer",
          "format": "int64",
          "default": 300
        }
      },
      "additionalProperties": false,
      "required": [
        "jwt_issuer",
        "jwt_access_token_expiration",
        "jwt_refresh_token_expiration",
        "jwt_audiences"
      ]
    },
    "JwtAudience": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "web",
            "api",
            "a2a",
            "mcp",
            "internal",
            "bridge",
            "hook"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "TrustedIssuer": {
      "description": "A federated identity provider trusted for the RFC 8693 token-exchange and\nEMA (Enterprise-Managed Authorization) paths.\n\n`audience` holds the value the `IdP` places in `id_token.aud`; for a\nSalesforce Connected App that is its `client_id`, **not** a URL.",
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "jwks_uri": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "typ_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_client_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "can_issue_id_jag": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "issuer",
        "jwks_uri",
        "audience"
      ]
    },
    "RateLimitsConfig": {
      "description": "Per-route-group request budgets, in requests per second.\n\nEach `*_per_second` field governs one route group:\n\n- `oauth_public` — `/api/v1/core/oauth` public endpoints,\n  `/auth/link-passkey`, and the public gateway session routes under\n  `/api/public/gateway`.\n- `oauth_auth` — the authenticated half of `/api/v1/core/oauth`, plus\n  `/api/v1/core/users`.\n- `contexts` — `/api/v1/core/contexts` and the inbound `/api/v1/webhook`\n  mount.\n- `tasks` — `/api/v1/core/tasks`.\n- `artifacts` — `/api/v1/core/artifacts`.\n- `agent_registry` — `/api/v1/agents/registry`, discovery only, kept apart\n  from `agents_per_second` so listing agents cannot spend an execution\n  budget.\n- `agents` — `/api/v1/agents` execution, and the Slack and Teams inbound\n  mounts that dispatch to an agent.\n- `mcp_registry` — `/api/v1/mcp/registry`, the MCP server catalog, discovery\n  only.\n- `mcp` — `/api/v1/mcp` tool calls, the busiest protocol route group.\n- `stream` — `/api/v1/stream`, long-lived SSE connections, so this is a\n  connection budget rather than a request one and is set high.\n- `content` — `/api/v1/content`, `/api/v1/sync`, `/api/v1/marketplace`,\n  `/api/v1/analytics` and `/track/engagement`.\n- `gateway` — inference traffic under `/v1`: `/v1/messages` and the\n  OpenAI-shaped `/v1/chat/completions`.\n- `bridge_auth` — `/v1/auth/bridge/*`, deliberately separate from\n  `gateway_per_second`: sign-in is low-volume and must stay reachable on an\n  instance whose inference traffic is saturating its own budget. Sharing one\n  bucket let a busy gateway lock every user out of authenticating.\n\n`per_second_budgets` projects those fields as a list; both validators\niterate it rather than naming the fields themselves, which had already let\nthem drift apart and let a zero in an unnamed field through.",
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "oauth_public_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "oauth_auth_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "contexts_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "tasks_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "artifacts_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "agent_registry_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "agents_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 20
        },
        "mcp_registry_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "mcp_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 200
        },
        "stream_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "content_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 50
        },
        "gateway_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 100
        },
        "bridge_auth_per_second": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 20
        },
        "burst_multiplier": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "SystemAdminConfig": {
      "description": "Profile-supplied configuration for the platform owner. Must resolve at\nstartup to an active user row carrying the `admin` role; the platform\nrefuses to boot otherwise.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "username"
      ]
    },
    "RuntimeConfig": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "#/$defs/Environment",
          "default": "development"
        },
        "log_level": {
          "$ref": "#/$defs/LogLevel",
          "default": "normal"
        },
        "output_format": {
          "$ref": "#/$defs/OutputFormat",
          "default": "text"
        },
        "no_color": {
          "type": "boolean",
          "default": false
        },
        "non_interactive": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "LogLevel": {
      "type": "string",
      "enum": [
        "quiet",
        "normal",
        "verbose",
        "debug"
      ]
    },
    "OutputFormat": {
      "type": "string",
      "enum": [
        "text",
        "json",
        "yaml"
      ]
    },
    "CloudConfig": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation": {
          "$ref": "#/$defs/CloudValidationMode",
          "default": "strict"
        }
      },
      "additionalProperties": false
    },
    "CloudValidationMode": {
      "type": "string",
      "enum": [
        "strict",
        "warn",
        "skip"
      ]
    },
    "SecretsConfig": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/SecretsSource"
        },
        "validation": {
          "$ref": "#/$defs/SecretsValidationMode",
          "default": "warn"
        },
        "secrets_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "vault": {
          "anyOf": [
            {
              "$ref": "#/$defs/VaultSecretsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ]
    },
    "SecretsSource": {
      "type": "string",
      "enum": [
        "file",
        "env",
        "vault"
      ]
    },
    "SecretsValidationMode": {
      "type": "string",
      "enum": [
        "strict",
        "warn",
        "skip"
      ]
    },
    "VaultSecretsConfig": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "mount": {
          "type": "string",
          "default": "secret"
        },
        "path": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "auth": {
          "$ref": "#/$defs/VaultAuth"
        },
        "keys": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VaultKeyRef"
          },
          "default": {}
        },
        "ca_cert_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "retries": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "address",
        "path",
        "auth"
      ]
    },
    "VaultAuth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "token_env": {
              "type": "string",
              "default": "VAULT_TOKEN"
            },
            "token_file": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "method": {
              "type": "string",
              "const": "token"
            }
          },
          "additionalProperties": false,
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "role_id_env": {
              "type": "string",
              "default": "VAULT_ROLE_ID"
            },
            "secret_id_env": {
              "type": "string",
              "default": "VAULT_SECRET_ID"
            },
            "mount": {
              "type": "string",
              "default": "approle"
            },
            "method": {
              "type": "string",
              "const": "approle"
            }
          },
          "additionalProperties": false,
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "jwt_path": {
              "type": "string",
              "default": "/var/run/secrets/kubernetes.io/serviceaccount/token"
            },
            "mount": {
              "type": "string",
              "default": "kubernetes"
            },
            "method": {
              "type": "string",
              "const": "kubernetes"
            }
          },
          "additionalProperties": false,
          "required": [
            "method",
            "role"
          ]
        }
      ]
    },
    "VaultKeyRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "field"
      ]
    },
    "ExtensionsConfig": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "GovernanceConfig": {
      "type": "object",
      "properties": {
        "authz": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthzConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audit": {
          "$ref": "#/$defs/AuditConfig",
          "default": {
            "payload_cap_bytes": 1048576
          }
        }
      },
      "additionalProperties": false
    },
    "AuthzConfig": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "#/$defs/AuthzHookConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "hook"
      ]
    },
    "AuthzHookConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/AuthzMode"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 500
        },
        "acknowledgement": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "AuthzMode": {
      "type": "string",
      "enum": [
        "webhook",
        "extension",
        "disabled",
        "unrestricted"
      ]
    },
    "AuditConfig": {
      "description": "Retention bounds for the gateway audit trail.",
      "type": "object",
      "properties": {
        "payload_cap_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1048576
        }
      },
      "additionalProperties": false
    },
    "JudgeProfile": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RetentionConfig": {
      "description": "Retention windows, in days, for the high-volume operational tables.\n\nEach field names the table it bounds and rows older than the window are\ndeleted, with two exceptions worth knowing:\n\n- `ai_request_messages_days` drops the stored messages and keeps the request\n  row; `None` follows `ai.history.retention_days` from the services\n  configuration instead.\n- `ai_request_payload_raw_days` sets the raw request and response bodies on\n  `ai_request_payloads` to NULL rather than deleting the row; the excerpts,\n  hashes and sizes stay.",
      "type": "object",
      "properties": {
        "logs_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 30
        },
        "analytics_events_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 90
        },
        "ai_request_messages_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "mcp_tool_executions_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 365
        },
        "outbox_processed_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 7
        },
        "ai_request_payload_raw_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 7
        },
        "governance_decisions_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 180
        }
      },
      "additionalProperties": false
    },
    "ServicesProfileConfig": {
      "type": "object",
      "properties": {
        "port_offset": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServicesSource"
          },
          "default": []
        },
        "cache_dir": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "on_fetch_failure": {
          "$ref": "#/$defs/FetchFailurePolicy",
          "default": "use_last_good"
        }
      },
      "additionalProperties": false
    },
    "ServicesSource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "https": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpsServicesSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "oci": {
          "anyOf": [
            {
              "$ref": "#/$defs/OciServicesSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "HttpsServicesSource": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "auth_secret": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "verify": {
          "$ref": "#/$defs/BundleVerification",
          "default": {
            "sha256": null,
            "ed25519_public_keys": []
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "url"
      ]
    },
    "BundleVerification": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "ed25519_public_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "OciServicesSource": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string"
        },
        "auth_secret": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "verify": {
          "$ref": "#/$defs/BundleVerification",
          "default": {
            "sha256": null,
            "ed25519_public_keys": []
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "reference"
      ]
    },
    "FetchFailurePolicy": {
      "type": "string",
      "enum": [
        "fail_closed",
        "use_last_good",
        "use_bundled"
      ]
    },
    "StorageConfig": {
      "description": "Where user-visible files are written and whether the root is shared\nbetween replicas.\n\n`shared: true` declares that `paths.storage` is a mount every replica can\nsee; boot warns when the declaration and the observed mount disagree.",
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/StorageBackend",
          "default": "local"
        },
        "shared": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "StorageBackend": {
      "type": "string",
      "enum": [
        "local"
      ]
    },
    "ObservabilityConfig": {
      "type": "object",
      "properties": {
        "otlp": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtlpExportConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "OtlpExportConfig": {
      "description": "An OTLP collector to export traces and logs to.",
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/OtlpProtocol",
          "default": "http"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OtlpSignal"
          },
          "default": [
            "traces",
            "logs"
          ]
        },
        "batch_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 15
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint"
      ]
    },
    "OtlpProtocol": {
      "type": "string",
      "enum": [
        "http",
        "grpc"
      ]
    },
    "OtlpSignal": {
      "type": "string",
      "enum": [
        "traces",
        "logs"
      ]
    }
  }
}
