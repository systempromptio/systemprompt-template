target/
# Scaled scenario binaries are staged into deploy/scenarios/scaled/.bin/ (a real
# dir inside the context) because `target` is a symlink escaping the context.
.git/
node_modules/
**/node_modules/
web/dist/
storage/data/
.systemprompt/profiles/
.systemprompt/sessions/
.systemprompt/credentials.json
.systemprompt/tenants.json
reports/
# demo/ ships in the image for the homepage demo catalogue, but only the
# scanned category dirs with commands that work against a deployed instance.
# Scenario stacks and recordings are local-only; .token files are live JWTs.
demo/scenarios/
demo/recording/
demo/.token
demo/.token.user
docs/
docs-internal/
logs/
*.log
.env
.env.*
!.env.example
Screenshot*.png

# Local build state and browser credentials must never enter an image context.
.build/
playwright/node_modules/
playwright/.auth/
playwright/test-results/
playwright/playwright-report/
.core-sibling/
signing_key.pem

**/target/
**/.env
**/.env.*
**/signing_key.pem

# Never ship a key into an image, even from a local build that has one on disk.
*.pem
**/*.pem
# Build residue outside target/ (coverage runs, local packaging, CI's core checkout)
dist/
coverage-report/
.vendor/
