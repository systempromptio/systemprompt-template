# Android release signing. Copy to extensions/mobile/android/keystore.properties
# (untracked) and fill in. Never commit the copy or the keystore it names.
# On a runner, write this file from the workflow's secrets instead.
storeFile=/absolute/path/outside/the/repository/release.jks
storePassword=REPLACE_WITH_THE_KEYSTORE_PASSWORD
keyAlias=REPLACE_WITH_THE_KEY_ALIAS
keyPassword=REPLACE_WITH_THE_KEY_PASSWORD
