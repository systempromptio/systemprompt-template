# The toolchain the mobile apps are built with. One pin per line, KEY=value,
# no quotes and no spaces around "=", so a shell can source it and any other
# tool can read it line by line. shared/env.sh loads it for the build scripts;
# scripts/mobile/android-sdk.sh installs the Android packages it names;
# scripts/mobile/toolchain.sh prints it and fails when the Gradle wrapper, the
# version catalog, the Xcode project or the Mobile workflow disagree with it.
# Moving a pin means changing it here and in the file that toolchain.sh names.

# The reference app. A fork changes these to its own.
MOBILE_APP_ID=io.systemprompt.mobile
MOBILE_APP_VERSION=0.70.0

# Android app
MOBILE_JDK=17
MOBILE_GRADLE=9.9.2
MOBILE_AGP=9.5.3
MOBILE_KOTLIN=2.4.21
MOBILE_ANDROID_COMPILE_SDK=36
MOBILE_ANDROID_TARGET_SDK=36
MOBILE_ANDROID_MIN_SDK=26
MOBILE_ANDROID_BUILD_TOOLS=36.0.0

# iOS app
MOBILE_XCODE_MIN=16.0
MOBILE_IOS_MIN=17.0
MOBILE_SWIFT=6.0
MOBILE_SWIFTLINT=0.65.1
MOBILE_SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0

# The Rust library step (not built yet: it arrives with the
# systemprompt-mobile crate). The Rust toolchain itself is the template's
# rust-toolchain.toml.
MOBILE_ANDROID_NDK=29.0.14206865
MOBILE_CARGO_NDK=4.1.2
MOBILE_RUST_TARGETS_ANDROID=aarch64-linux-android,armv7-linux-androideabi,x86_64-linux-android
MOBILE_RUST_TARGETS_IOS=aarch64-apple-ios,aarch64-apple-ios-sim,x86_64-apple-ios
