{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            d.id AS \"id!\",\n            d.name AS \"name!\",\n            d.description AS \"description!\",\n            (SELECT COUNT(*) FROM organization_members m\n               JOIN user_profile_ext e ON e.user_id = m.user_id\n              WHERE m.org_id = d.org_id AND e.department = d.name) AS \"member_count!\"\n        FROM departments d\n        WHERE d.org_id = $1\n        ORDER BY d.name\n        ",
