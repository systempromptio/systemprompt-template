  "query": "\n        SELECT\n            id as \"id!: AiRequestId\",\n            user_id as \"user_id!: UserId\",\n            actor_kind as \"actor_kind!\",\n            actor_id as \"actor_id!\",\n            provider,\n            model,\n            input_tokens,\n            output_tokens,\n            cost_microdollars as \"cost_microdollars!\",\n            latency_ms,\n            status as \"status!\",\n            error_message\n        FROM ai_requests\n        WHERE id = $1 OR id LIKE $2\n        LIMIT 1\n        ",
