{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="Every item this run scored, worst first."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/evals">All evals</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        <span class="sp-u-mono">{{run.id}}</span>
        <span>started {{run.created_at_local}} by {{run.created_by}}</span>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Run summary">
        {{> components/kpi label="Kind" value=run.kind_label note=run.status tone=run.status_tone}}
        {{> components/kpi label="Scored" value=run.scored_count unit=(concat "of " run.sample_size) note=(concat run.failed_count " failed")}}
        {{> components/kpi label="Mean score" value=run.mean_score_display unit="/ 5" note="across scored items"}}
        {{> components/kpi label="Judge cost" value=run.cost_display note=run.judge_model}}
    </section>

    {{> components/section title="Results" count=result_count note="Score, verdict and the judge's reason for every item. Hover a cell for the full text."}}
    {{#if results}}
    {{> evals/results-table results=results}}
    {{else}}
    {{> components/empty-state title="Nothing scored" message="This run scored nothing. A failed run records its error on the Evals page notice; a running one fills in as it goes."}}
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
