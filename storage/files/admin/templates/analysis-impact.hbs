{{#> layout title=title page=page}}{{#*inline "content"}}
{{> components/page-header title=title subtitle="Compare revision-attributed production cohorts with visible uncertainty."}}
{{> components/notice tone="info" title="Association, not causation" message="Before/after cohorts are associations, not causal estimates. Related conversation cost overlaps when several skills occur in one conversation and must not be summed across skills. Missing attribution and unknown accounting remain visible."}}
<form method="get" class="sp-analysis-filters"><label>Skill <input name="skill" value="{{query.skill}}"></label><label>Revision <input name="revision" value="{{query.revision}}"></label><label>Traffic <select name="traffic_class"><option value="">All</option><option>production</option><option>fixture</option><option>live_evaluation</option><option>suggestion</option><option>judge</option></select></label><button class="sp-btn" type="submit">Apply cohort</button></form>
{{> components/notice tone="info" title="Selected cohort" message="Attributed and accounting coverage denominators are retained below; platform request spending is deduplicated by request ID and tool charges remain separate."}}
<p>{{summary.attributed}} / {{summary.invocations}} invocations attributed; {{summary.accounted_requests}} / {{summary.distinct_requests}} distinct requests accounted. Platform request spend (request-deduplicated) is {{summary.deduplicated_request_cost_microdollars}} µ$.</p>
<h2>Revision cohorts and daily trends</h2><div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Day / skill / revision</th><th>Traffic</th><th>Sample</th><th>Attribution</th><th>Failures</th><th>Accounting</th><th>Latency</th><th>Costs</th></tr></thead><tbody>
{{#each rows}}<tr><td>{{cohort_day}} · {{skill}}<br><small>{{#if revision_id}}{{revision_id}} · generation {{publication_generation}}{{else}}revision unknown{{/if}}</small></td><td>{{traffic_class}}</td><td>{{invocations}} invocations · {{requests}} requests · {{tokens}} tokens<br><small>{{successful_sessions}} / {{assessed_sessions}} successful assessed sessions · mean quality {{average_quality_score}}</small></td><td>{{attributed}} / {{invocations}}</td><td>{{failures}}</td><td>{{accounted_requests}} / {{requests}}</td><td>{{average_latency_ms}} ms</td><td>{{related_conversation_cost_microdollars}} µ$ related conversation (overlapping)</td></tr>{{else}}<tr><td colspan="8">No observed invocations in this cohort.</td></tr>{{/each}}</tbody></table></div></div>
<h2>Invocation → conversation → request/tool evidence</h2><div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Invocation</th><th>Skill</th><th>Attribution</th><th>Conversation</th><th>Requests</th><th>Tools</th></tr></thead><tbody>{{#each invocations}}<tr><td>{{invocation_id}}</td><td>{{skill}}<br><small>{{revision_id}}</small></td><td>{{attribution_status}} · {{traffic_class}}</td><td><a href="/admin/sessions/{{session_id}}">{{session_id}}</a></td><td>{{accounted_count}} accounted / {{request_count}}<br><small>{{request_ids}}</small></td><td>{{tool_count}}</td></tr>{{else}}<tr><td colspan="6">No invocation evidence.</td></tr>{{/each}}</tbody></table></div></div>
<h2>Reviewed production-failure capture</h2><p>Create a sanitized development-only case. This never changes a holdout or publishes a skill.</p>
<form method="post" action="/admin/analysis/impact/capture"><label>Production invocation ID <input name="invocation_id" required maxlength="255"></label><label>Sanitized reproduction prompt <textarea name="prompt" required maxlength="16000"></textarea></label><label>Expected behaviours (one per line) <textarea name="expected_behavior" required maxlength="16000"></textarea></label><label>Deterministic assertion names (comma separated) <input name="assertions" required maxlength="2000"></label><button class="sp-btn" type="submit">Create development case revision</button></form>
{{/inline}}{{/layout}}
