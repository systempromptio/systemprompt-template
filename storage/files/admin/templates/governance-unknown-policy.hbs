{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="The chain has no policy registered under this id."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance">All policies</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        <span><code class="sp-code-inline">{{policy_id}}</code></span>
        {{/inline}}
    {{/components/page-header}}
    {{> components/empty-state title="Unknown policy" message="No Rust impl submits a PolicyRegistration with this id. It may have been renamed or removed; the policies list shows historical ids that still have decisions on record."}}
    {{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
