{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Every policy the chain runs, in execution order, with what it decided in the last 24 hours. Policies are Rust code; order, enablement and parameters are config."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance/decisions">Decisions</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance/hooks">Hooks</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        <span>Config <code class="sp-code-inline">{{config_path}}</code></span>
        <span>The driver stops at the first deny; edits to the file reload without a restart.</span>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Enforcement summary">
        {{#each kpis}}
        {{> components/kpi label=this.label value=this.value note=this.note tone=this.tone href=this.href}}
        {{/each}}
    </section>

    {{#> components/section title="Policy chain" count=policy_count note="Execution order, current parameters, and 24h enforcement counts from governance_decisions."}}{{/components/section}}

    {{#if has_policies}}
    {{#> components/table caption="Policy chain in execution order" modifier="sp-p-governance__table"}}
        <thead><tr>
            <th scope="col" class="sp-p-governance__order">#</th>
            <th scope="col">Policy</th>
            <th scope="col" class="sp-col-status">State</th>
            <th scope="col">Parameters</th>
            <th scope="col" class="sp-table__cell--num">Evaluations 24h</th>
            <th scope="col" class="sp-table__cell--num">Allowed</th>
            <th scope="col" class="sp-table__cell--num">Denied</th>
            <th scope="col" class="sp-table__cell--num">Deny rate</th>
            <th scope="col" class="sp-col-date">Last fired</th>
            <th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
        </tr></thead>
        <tbody>
        {{#each policies}}
        <tr>
            <td class="sp-p-governance__order sp-u-num">{{order}}</td>
            <td class="sp-p-governance__policy" title="{{description}}"><a href="{{edit_url}}">{{name}}</a> <code class="sp-code-inline">{{id}}</code></td>
            <td>{{> components/badge tone=state_tone text=state}}</td>
            <td class="sp-p-governance__params" title="{{params_line}}">{{#if has_params}}{{params_line}}{{else}}<span class="sp-u-text-muted">none</span>{{/if}}</td>
            <td class="sp-table__cell--num sp-u-num">{{formatNumber window_evaluations}}</td>
            <td class="sp-table__cell--num sp-u-num">{{formatNumber window_allowed}}</td>
            <td class="sp-table__cell--num sp-u-num">{{#if has_recent_denies}}<a class="sp-u-text-danger" href="{{deny_decisions_url}}">{{formatNumber window_denied}}</a>{{else}}{{window_denied}}{{/if}}</td>
            <td class="sp-table__cell--num sp-u-num">{{deny_rate}}</td>
            <td class="sp-table__cell--date">{{#if last_at}}{{last_at}}{{else}}—{{/if}}</td>
            <td class="sp-table__cell--actions"><a class="sp-p-governance__action" href="{{decisions_url}}">Decisions</a></td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{#unless has_enforcement_activity}}
    <p class="sp-u-text-muted sp-u-text-sm">No policy evaluations in the last 24h. Run a few tool calls (or one of the demo/governance/*.sh scripts) to populate the counts.</p>
    {{/unless}}
    {{else}}
    {{> components/empty-state title="No policies registered" message="Build the workspace and check that extensions/web/admin/src/handlers/webhook/governance/policies/ submits at least one PolicyRegistration."}}
    {{/if}}

    <div class="sp-p-governance__ranks">
        <div>
            {{#> components/section title="Top denying tool calls" note="Last 24h, by policy and tool."}}{{/components/section}}
            {{#if has_top_tools}}
            {{#> components/table caption="Top denying tool calls in the last 24h" modifier="sp-p-governance__rank"}}
                <thead><tr>
                    <th scope="col">Policy</th>
                    <th scope="col">Tool</th>
                    <th scope="col" class="sp-table__cell--num">Denies</th>
                    <th scope="col" class="sp-table__cell--num">Actors</th>
                </tr></thead>
                <tbody>
                {{#each top_tools}}
                <tr>
                    <td><a href="{{decisions_url}}"><code class="sp-code-inline">{{policy}}</code></a></td>
                    <td class="sp-u-mono sp-u-truncate" title="{{tool_name}}">{{tool_name}}</td>
                    <td class="sp-table__cell--num sp-u-num sp-u-text-danger">{{formatNumber hits}}</td>
                    <td class="sp-table__cell--num sp-u-num">{{formatNumber distinct_actors}}</td>
                </tr>
                {{/each}}
                </tbody>
            {{/components/table}}
            {{else}}
            {{> components/empty-state title="No denied tool calls" message="Nothing was denied in the last 24h."}}
            {{/if}}
        </div>
        <div>
            {{#> components/section title="Top denied actors" note="Last 24h, by person."}}{{/components/section}}
            {{#if has_top_actors}}
            {{#> components/table caption="Top denied actors in the last 24h" modifier="sp-p-governance__rank"}}
                <thead><tr>
                    <th scope="col">Person</th>
                    <th scope="col" class="sp-table__cell--num">Denies</th>
                    <th scope="col" class="sp-table__cell--num">Secrets</th>
                    <th scope="col" class="sp-table__cell--num">Decisions</th>
                </tr></thead>
                <tbody>
                {{#each top_actors}}
                <tr>
                    <td class="sp-u-truncate" title="{{email}}"><a href="{{user_url}}">{{display_name}}</a></td>
                    <td class="sp-table__cell--num sp-u-num"><a class="sp-u-text-danger" href="{{decisions_url}}">{{formatNumber deny_count}}</a></td>
                    <td class="sp-table__cell--num sp-u-num">{{formatNumber secret_count}}</td>
                    <td class="sp-table__cell--num sp-u-num">{{formatNumber total}}</td>
                </tr>
                {{/each}}
                </tbody>
            {{/components/table}}
            {{else}}
            {{> components/empty-state title="No actor denies" message="No one was denied in the last 24h."}}
            {{/if}}
        </div>
    </div>

    {{#if has_orphans}}
    <details class="sp-p-governance__orphans">
        <summary>Historical policies no longer registered · {{orphans_count}}</summary>
        <p class="sp-u-text-muted sp-u-text-sm">These ids appear in governance_decisions but no Rust impl is registered for them — likely renamed or removed.</p>
        {{#> components/table caption="Policies with decisions but no registration" modifier="sp-p-governance__rank"}}
            <thead><tr>
                <th scope="col">Policy id</th>
                <th scope="col" class="sp-table__cell--num">Allowed</th>
                <th scope="col" class="sp-table__cell--num">Denied</th>
                <th scope="col" class="sp-col-date">Last seen</th>
            </tr></thead>
            <tbody>
            {{#each orphans}}
            <tr>
                <td><code class="sp-code-inline">{{id}}</code></td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber allowed}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber denied}}</td>
                <td class="sp-table__cell--date">{{last_at}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
    </details>
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
