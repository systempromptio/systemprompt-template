{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="Four phases from a fresh account to a governed skill library. Phase 1 is required — without it nothing else does anything."}}
        {{#*inline "header_meta"}}
            <span>{{marketplace.site_url}}</span>
            <span><span class="sp-u-num">{{complete_count}}</span> of <span class="sp-u-num">{{phase_count}}</span> phases complete</span>
        {{/inline}}
        {{#*inline "header_actions"}}
            <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/access-tokens">Issue an access token</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/documentation/connect-claude-code">Read the guide</a>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Setup progress">
        {{> components/kpi label="Phases complete" value=complete_count note=(concat "of " phase_count) tone="ok"}}
        {{> components/kpi label="Plugins reaching you" value=total_plugins note="phase 1 and 2 signal"}}
        {{> components/kpi label="Skills in your library" value=total_skills note="phase 3 signal" href="/admin/contexts"}}
    </section>

    {{#if just_verified}}
    {{> components/notice tone="ok" title="Connected" message="This machine is signed in to the gateway. Phase 1 is done."}}
    {{/if}}

    <section aria-label="Setup phases">
        {{> components/section title="Phases" count=phase_count note="Completion is derived from what actually reaches this account — plugin and skill counts — not from a checkbox you tick."}}
        {{#> components/table caption="The four setup phases, in order"}}
            <thead><tr>
                <th scope="col" class="sp-table__cell--num">#</th>
                <th scope="col">Phase</th>
                <th scope="col">Why it matters</th>
                <th scope="col">Status</th>
                <th scope="col" class="sp-table__cell--actions">Go</th>
            </tr></thead>
            <tbody>
            {{#each phases}}
            <tr{{#if current}} class="is-active"{{/if}}>
                <td class="sp-table__cell--num sp-u-num">{{number}}</td>
                <td>{{this.phase_title}}</td>
                <td>{{description}}</td>
                <td>{{> components/badge tone=status_tone text=status_label}}</td>
                <td class="sp-table__cell--actions">
                    <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{guide_url}}" target="_blank" rel="noopener noreferrer">Guide</a>
                    {{#if action_url}}<a class="sp-btn sp-btn--sm sp-btn--primary" href="{{action_url}}">{{action_label}}</a>{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    {{#if just_verified}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-setup-verified.js"></script>
    {{/if}}
    {{/inline}}
{{/layout}}
