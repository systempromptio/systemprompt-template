{{#> layout title=title page=page}}
{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Understand how skills are used, what related conversations consume, and where measurement can improve."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/evaluations">Evaluation readiness</a>{{/inline}}
{{/components/page-header}}
<div class="sp-kpi-grid">
{{> components/kpi label="Observed invocations" value=totals.uses note="Slash commands and Skill tool signals"}}
{{> components/kpi label="Conversations" value=totals.conversations note="Distinct owner and native session pairs"}}
{{> components/kpi label="Linked conversations" value=totals.linked note="Explicit session or tool ID evidence"}}
{{> components/kpi label="Related request spend" value=cost note="Each linked request counted once"}}
</div>
<form class="sp-analysis-filters" method="get" action="/admin/analysis/skills">
<label>From (UTC)<input type="datetime-local" step="1" name="start" value="{{filter.start}}" required></label>
<label>Until (UTC, exclusive)<input type="datetime-local" step="1" name="end" value="{{filter.end}}" required></label>
<label>Skill<input name="skill" value="{{filter.skill}}" placeholder="All skills"></label>
<label>User ID<input name="user" value="{{filter.user}}" placeholder="All users"></label>
<label>Model<input name="model" value="{{filter.model}}" placeholder="All models"></label>
<button class="sp-btn sp-btn--primary" type="submit">Apply</button>
</form>
<p class="sp-analysis-note"><strong>{{totals.linked}} of {{totals.conversations}} conversations have linked requests.</strong> Related spend covers this subset. {{totals.measured}} of {{totals.requests}} linked requests have completed token measurements. {{formatNumber totals.tokens}} recorded tokens include input, output, cache reads and cache creation. Unlinked usage has unknown spend. Historical traffic may include unmarked test data.</p>
{{#if detail}}
<h2>{{filter.skill}}</h2>
<div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table" aria-label="Skill usage measurements"><thead><tr><th>Conversation / owner</th><th>Uses</th><th>Requests measured</th><th>Tokens</th><th>Related cost</th><th>Tool activity</th><th>Outcome evidence</th></tr></thead><tbody>
{{#each conversations}}<tr><td><a href="{{href}}">{{row.session_id}}</a><br><small>{{row.user_id}}</small>{{#each row.contexts}}<br><a href="/admin/contexts/{{this}}">Request thread {{this}}</a>{{/each}}</td><td class="sp-table__cell--num sp-u-num">{{row.uses}}</td><td class="sp-table__cell--num sp-u-num">{{row.measured}} / {{row.requests}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.measured}}{{formatNumber row.tokens}}{{else}}Unknown{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.measured}}{{cost}}{{else}}Unknown{{/if}}</td><td>Observed: {{#if row.observed_tools}}{{row.observed_tools}}{{else}}No tool signals{{/if}}<br>Requested: {{#if row.tools}}{{row.tools}}{{else}}No linked tool requests{{/if}}</td><td>AI assessment: {{#if row.assessment}}{{row.assessment}}{{else}}Not assessed{{/if}}<br>Human rating: {{#if row.rating}}{{row.rating}} / 5{{else}}Not rated{{/if}}</td></tr>
{{else}}<tr><td colspan="7">No conversations match this window and these filters.</td></tr>{{/each}}
</tbody></table></div></div>
{{else}}
<div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table" aria-label="Skill usage measurements"><thead><tr><th>Skill</th><th>Observed uses</th><th>Conversations</th><th>Linked</th><th>Recorded tokens</th><th>Related cost</th><th>Failed requests</th></tr></thead><tbody>
{{#each skills}}<tr><td><a href="{{href}}">{{row.skill}}</a></td><td class="sp-table__cell--num sp-u-num">{{row.uses}}</td><td class="sp-table__cell--num sp-u-num">{{row.conversations}}</td><td class="sp-table__cell--num sp-u-num">{{row.linked}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.measured}}{{formatNumber row.tokens}}{{else}}Unknown{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.measured}}{{cost}}{{else}}Unknown{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{row.failures}}</td></tr>
{{else}}<tr><td colspan="7">No observed skill use in this window. Try an earlier date range or clear the filters.</td></tr>{{/each}}
</tbody></table></div></div>
{{/if}}
<nav class="sp-analysis-pagination" aria-label="Analysis pages">{{#if previous}}<a class="sp-btn sp-btn--outline" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="sp-btn sp-btn--outline" href="{{next}}">Next</a>{{/if}}</nav>
<details class="sp-analysis-definitions"><summary>How to interpret these measurements</summary>
<p>Related cost covers linked requests within the selected UTC window. It is not the marginal cost of a skill or tool. A conversation using several skills appears under each skill; skill rows must not be added together. The headline spend removes overlapping requests.</p>
<p>Invocation signals indicate observed use, not successful execution or quality. Historical hook deliveries may contain duplicates. Explicitly synthetic requests and evaluation execution sessions are excluded; older records without reliable provenance may still contain test traffic.</p>
<p>Model filtering includes only conversations with a matching linked request. Unlinked conversations therefore disappear with a model filter. AI assessments and human ratings are separate evidence, not evaluation results. Reasoning tokens are already included in output and are not added twice.</p>
</details>
{{/inline}}{{/layout}}
