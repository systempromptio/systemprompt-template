<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} - Verify Your Email</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body class="sp-auth-light">
    <main class="sp-login-container">
        <div class="sp-card sp-auth-card">
            <div class="sp-card__body">
            <div class="sp-login-logo">
                <img src="/files/images/logo.svg" alt="{{branding.domain}}" height="40" class="sp-logo-light">
                <img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="40" class="sp-logo-dark">
            </div>
            <p class="sp-login-subtitle">Verify your email</p>

            <div id="verify-message" class="sp-auth-sent">
                <p class="sp-auth-sent__title">Check your inbox</p>
                <p class="sp-login-switch">
                    We've sent a verification link to your email address.
                    Click the link to activate your account. The link expires in 24 hours.
                </p>

                <div id="resend-success" class="sp-login-error sp-login-error--success" role="status" hidden>
                    Verification email sent!
                </div>
                <div id="resend-error" class="sp-login-error" role="alert" hidden></div>

                <div class="sp-form-group">
                    <label for="resend-email">Email</label>
                    <input class="sp-field-input" type="email" id="resend-email" placeholder="you@company.com" required autocomplete="email">
                </div>
                <div class="sp-form-actions">
                    <button type="button" id="resend-btn" class="sp-btn sp-btn--primary sp-u-w-full">Resend verification email</button>
                </div>
            </div>

            <p class="sp-login-switch">
                <a href="/api/public/auth/session" data-action="resend-verification">Sign out</a>
            </p>
            </div>
        </div>
    </main>

    <script data-cfasync="false" type="module" src="/js/pages/admin-verify-pending.js?v={{css_version}}"></script>
</body>
</html>
