{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="What went through the gateway, and whether the answers were any good."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Request log</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/models">Models</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        <span><strong>{{traffic.total}}</strong> requests in window</span>
        <span><strong>{{scores.scored_count}}</strong> judged</span>
        {{#if is_judge}}<span>mean <strong>{{scores.mean_score_display}}</strong> / 5 · <strong>{{scores.pass_count}}</strong> pass · <strong>{{scores.partial_count}}</strong> partial · <strong>{{scores.fail_count}}</strong> fail · <strong>{{scores.coverage_pct}}%</strong> coverage</span>{{/if}}
        {{#if time_range.auto_widened}}<span>no requests in the last 24h, widened to {{time_range.auto_widened}}</span>{{/if}}
        {{/inline}}
    {{/components/page-header}}

    {{> components/tabs tabs=tabs nav_label="Evals sections"}}

    {{> components/time-range time_range}}

    {{#if notice}}
    {{> components/notice tone=notice.tone message=notice.message}}
    {{/if}}

    {{#if show_traffic_kpis}}{{> evals/kpi-traffic}}{{/if}}
    {{#if show_quality_kpis}}{{> evals/kpi-quality}}{{/if}}

    {{#if is_overview}}{{> evals/overview}}{{/if}}
    {{#if is_traffic}}{{> evals/traffic}}{{/if}}
    {{#if is_judge}}{{> evals/judge}}{{/if}}
    {{#if is_head_to_head}}{{> evals/head-to-head}}{{/if}}
    {{#if is_golden_set}}{{> evals/golden-set}}{{/if}}
    {{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
