{{#> layout title=title page=page}}{{#*inline "content"}}
{{> components/page-header title=title subtitle="Create an immutable candidate; the active skill remains unchanged."}}
<p>Baseline: <a href="/admin/analysis/revisions/{{baseline}}">{{baseline}}</a>. Supporting files and dependencies are inherited exactly.</p>
<form class="sp-analysis-editor" method="post" action="/admin/analysis/revisions/{{baseline}}/edit">
<input type="hidden" name="path" value="SKILL.md">
<label for="skill-content">Skill instructions</label><textarea id="skill-content" name="content" rows="24" required>
{{content}}</textarea>
<label for="skill-rationale">What should improve, and why?</label><textarea id="skill-rationale" name="rationale" rows="3" maxlength="4000" required></textarea>
<button class="sp-btn sp-btn--primary" type="submit">Save candidate and compare</button>
</form>
{{/inline}}{{/layout}}
