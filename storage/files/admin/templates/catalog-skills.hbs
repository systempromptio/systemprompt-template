{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle=subtitle}}
        {{#*inline "header_meta"}}
            <span>Read-only: services/skills/&lt;id&gt;/config.yaml</span>
        {{/inline}}
        {{#*inline "header_actions"}}
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analytics?tab=skills">Skill activity</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{access_control_url}}">Who can run these</a>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Skill totals">
        {{#each kpis}}
        {{> components/kpi label=this.label value=this.value note=this.sub tone=this.tone}}
        {{/each}}
    </section>

    <section aria-label="Skills">
    {{> components/section title="Skills" count=skills_count note="Definitions. Who actually runs them is on the skills tab of AI activity."}}
    {{#> components/toolbar toolbar_count=skills_count}}
        {{#*inline "toolbar_filters"}}
        <form class="sp-toolbar__search" method="get" action="/admin/skills" role="search">
            <label class="sp-u-sr-only" for="catalog-search">Search skills</label>
            <input type="search" name="q" class="sp-search-input" id="catalog-search" value="{{search}}" placeholder="Filter skills…">
        </form>
        {{/inline}}
        {{#*inline "toolbar_actions"}}
        {{#if search}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/skills">Clear filter</a>{{/if}}
        {{/inline}}
    {{/components/toolbar}}

    {{#> components/table caption="Skills with the plugins that carry them, visibility and grants" modifier="sp-p-catalog__table"}}
        <thead><tr>
            {{#each sort_headers}}{{> components/sort-header this}}{{/each}}
            <th class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
        </tr></thead>
        <tbody>
        {{#each skills}}
        <tr data-skill-id="{{id}}">
            <td class="sp-table__cell--primary"><a class="sp-table__link" href="{{detail_url}}" title="{{description}}">{{name}}</a></td>
            <td>{{#if enabled}}{{> components/badge tone="ok" text="enabled"}}{{else}}{{> components/badge tone="muted" text="disabled"}}{{/if}}</td>
            <td class="sp-table__cell--num sp-u-num">{{plugin_count}}</td>
            <td>{{> components/visibility-badge visibility}}</td>
            <td class="sp-table__cell--num sp-u-num">{{#if assignment_count}}<a class="sp-table__link" href="{{matrix_url}}">{{assignment_count}}</a>{{else}}<span class="sp-u-text-tertiary">0</span>{{/if}}</td>
            <td class="sp-table__cell--actions">
                <a class="sp-btn sp-btn--xs sp-btn--outline" href="{{detail_url}}">Open</a>
            </td>
        </tr>
        {{else}}
        <tr class="sp-table__empty"><td colspan="6">
            {{#if search}}
            {{> components/empty-state title="Nothing matches" message="No skill matches that filter."}}
            {{else}}
            {{> components/empty-state title="No skills" message="Add a services/skills/<id>/config.yaml and restart."}}
            {{/if}}
        </td></tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    </section>
    {{/inline}}
{{/layout}}
