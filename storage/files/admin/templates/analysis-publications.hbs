{{#> layout title=title page=page}}{{#*inline "content"}}
{{> components/page-header title=title subtitle="Review immutable generations, delivery, installation and rollback evidence."}}
{{> components/notice tone="info" title="Separate governed states" message="Approval, marketplace distribution and verified installation are separate states. Publication retains existing access policies and never grants tools or permissions."}}
{{#if can_manage}}<details><summary>Review a publication, withdrawal or rollback</summary><form method="post" action="/admin/analysis/publications/review"><label>Resource ID <input name="resource_id" required></label><label>Revision ID <input name="revision_id"></label><label>Action <select name="action"><option value="initial_adoption">Initial baseline adoption</option><option value="publish_improvement">Publish evaluated improvement</option><option value="withdraw">Withdraw</option><option value="rollback">Rollback as new generation</option></select></label><label>Expected generation <input type="number" min="0" name="expected_generation" required></label><label>Idempotency key <input name="operation_key" required></label><label>Comparison evidence JSON <textarea name="comparison_evidence" required>{}</textarea></label><label>Limitations <textarea name="limitations"></textarea></label><button class="sp-btn sp-btn--primary" type="submit">Record review and publication</button></form></details>{{/if}}
<h2 id="publication-history">Publication history</h2><div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Resource</th><th>Generation</th><th>Review</th><th>Content</th><th>Distribution</th><th>Installation</th></tr></thead><tbody>{{#each rows}}<tr><td>{{resource_key}}<br><small>{{resource_id}}</small></td><td>{{generation}} · {{action}}</td><td>{{reviewer_id}}<br><small>{{review_id}}</small><br>{{limitations}}</td><td>{{revision_id}}<br><small>{{bundle_digest}}</small></td><td>{{distribution_status}}</td><td>{{installation_receipts}} immutable receipt(s)</td></tr>{{else}}<tr><td colspan="6">No reviewed publications.</td></tr>{{/each}}</tbody></table></div></div>
<h2>Upstream withdrawal proposals</h2>{{#each withdrawals}}<section><p>{{resource_id}} · {{reason}} · {{status}}</p>{{#if (eq status "pending")}}<form method="post" action="/admin/analysis/publications/withdrawals"><input type="hidden" name="proposal_id" value="{{id}}"><button name="decision" value="approve" type="submit">Approve proposal</button><button name="decision" value="reject" type="submit">Reject</button></form>{{/if}}</section>{{else}}<p>No upstream deletion proposals.</p>{{/each}}
<h2>Distribution deliveries</h2><div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Publication</th><th>Generation</th><th>Status</th><th>Claimed</th><th>Error</th></tr></thead><tbody>{{#each distributions}}<tr><td>{{publication_id}}</td><td>{{generation}}</td><td>{{status}}</td><td>{{claimed_at}}</td><td>{{error}}</td></tr>{{else}}<tr><td colspan="5">No delivery claims.</td></tr>{{/each}}</tbody></table></div></div>
<h2 id="installation-receipts">Verified installation receipts</h2><div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Installation</th><th>Publication</th><th>Generation</th><th>Retained digest</th><th>Verified evidence</th></tr></thead><tbody>{{#each receipts}}<tr><td>{{installation_id}}<br><small>{{id}}</small></td><td>{{publication_id}}</td><td>{{generation}}</td><td><code>{{bundle_digest}}</code></td><td>{{verified_at}}<details><summary>Exact files and client evidence</summary><pre>{{installed_manifest}}</pre><pre>{{client_evidence}}</pre></details></td></tr>{{else}}<tr><td colspan="5">No verified installation receipts.</td></tr>{{/each}}</tbody></table></div></div>
{{/inline}}{{/layout}}
