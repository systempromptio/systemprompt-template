{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Personal access tokens issued to accounts. A token authenticates any client calling the gateway as the account that owns it."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/users">Users</a>
        {{#if can_write}}
        <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="create-token">Issue token</button>
        {{/if}}
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Token totals">
        {{> components/kpi label="Tokens" value=total note="ever issued"}}
        {{> components/kpi label="Active" value=active note="usable now" tone="ok"}}
        {{> components/kpi label="Expiring" value=expiring_soon note="within 30 days" tone="warn"}}
        {{> components/kpi label="Revoked" value=revoked note="refused on use" tone="err"}}
    </section>

    {{#> components/section title="Issued tokens" count=total note="A token carries no scope of its own; every request runs as the owner's live role."}}
        {{#*inline "section_actions"}}
        {{#if filters_applied}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{clear_url}}">Clear filters</a>{{/if}}
        {{/inline}}
    {{/components/section}}

    <form class="sp-toolbar" method="get" action="/admin/access-tokens" role="search" aria-label="Filter tokens">
        <span class="sp-toolbar__count">{{shown}} of {{total}} tokens</span>
        <div class="sp-toolbar__field">
            <label class="sp-u-sr-only" for="tokens-filter-status">Status</label>
            <select class="sp-search-input" id="tokens-filter-status" name="status">
            {{#each status_options}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
        </div>
        <div class="sp-toolbar__field">
            <label class="sp-u-sr-only" for="tokens-filter-department">Department</label>
            <select class="sp-search-input" id="tokens-filter-department" name="department">
            {{#each department_options}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
        </div>
        <label class="sp-u-sr-only" for="tokens-filter-q">Search tokens</label>
        <div class="sp-toolbar__search">
            <input class="sp-search-input" id="tokens-filter-q" type="search" name="q" value="{{search}}" placeholder="Owner, token name or prefix">
        </div>
        <div class="sp-toolbar__actions">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--secondary">Apply</button>
        </div>
    </form>

    {{#if has_rows}}
    {{#> components/table caption="Personal access tokens with their owner, department, dates and status" modifier="sp-p-access-tokens__table"}}
        <thead><tr>
            <th scope="col">Owner</th>
            <th scope="col">Token</th>
            <th scope="col">Prefix</th>
            <th scope="col">Department</th>
            <th scope="col" class="sp-table__cell--date">Created</th>
            <th scope="col" class="sp-table__cell--date">Expires</th>
            <th scope="col" class="sp-table__cell--date">Last used</th>
            <th scope="col" class="sp-col-status">Status</th>
            <th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
        </tr></thead>
        <tbody>
        {{#each tokens}}
        <tr data-token-id="{{this.id}}">
            <td class="sp-u-truncate sp-u-mono" title="{{this.user_id}}"><a href="{{this.owner_url}}">{{this.owner}}</a></td>
            <td class="sp-u-truncate" title="{{this.name}}">{{this.name}}</td>
            <td class="sp-u-mono">{{this.key_prefix}}</td>
            <td class="sp-u-truncate">{{#if this.department}}<a href="{{this.department_url}}">{{this.department}}</a>{{else}}&mdash;{{/if}}</td>
            <td class="sp-table__cell--date">{{#if this.created_at}}<span title="{{formatDate this.created_at}}">{{relativeTime this.created_at}}</span>{{else}}&mdash;{{/if}}</td>
            <td class="sp-table__cell--date">{{#if this.expires_at}}<span title="{{formatDate this.expires_at}}">{{relativeTime this.expires_at}}</span>{{else}}Never{{/if}}</td>
            <td class="sp-table__cell--date">{{#if this.last_used_at}}<span title="{{formatDate this.last_used_at}}">{{relativeTime this.last_used_at}}</span>{{else}}Never{{/if}}</td>
            <td class="sp-col-status">{{> components/badge tone=this.status_tone text=this.status_label}}</td>
            <td class="sp-table__cell--actions">
                {{#if ../can_write}}{{#unless this.revoked}}<button type="button" class="sp-p-access-tokens__action sp-p-access-tokens__action--danger" data-revoke-token="{{this.id}}" data-token-user="{{this.user_id}}" data-token-name="{{this.name}}">Revoke</button>{{/unless}}{{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No tokens match" message="No token matches this status, department and search. Clear a filter, or issue a token for an account."}}
    {{/if}}

    {{#if can_write}}{{> components/create-token-panel user_options=user_options}}{{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-access-tokens.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
