{{#> layout page_title=title page_id=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Where this instance ships its telemetry. The profile's observability.otlp block names the collector, and core streams every enabled signal to it."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{docs_url}}" target="_blank" rel="noopener noreferrer">How export works</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{sync_url}}">Code ↔ Instance</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        {{#if exporter}}
        <span>Protocol <strong>{{exporter.protocol}}</strong></span>
        {{/if}}
        <span>Signals enabled <strong>{{signal_count}}</strong></span>
        {{/inline}}
    {{/components/page-header}}

    {{#unless configured}}
    {{> components/notice tone="warn" title="No collector configured" message="The active profile declares no observability.otlp block, so no signal is exported. Add the block to the profile (endpoint, protocol, headers, signals) and restart. Metrics are not affected: they stay on the Prometheus /metrics listener."}}
    {{/unless}}

    {{#if exporter}}
    {{#> components/section title="Exporter" note="Declared in the profile. Header values are credentials and are never shown."}}{{/components/section}}
    <dl class="sp-kv-list sp-obs-exporter">
        <div class="sp-kv-row"><dt>Endpoint</dt><dd><span class="sp-u-mono">{{exporter.endpoint}}</span></dd></div>
        <div class="sp-kv-row"><dt>Protocol</dt><dd>{{exporter.protocol}}</dd></div>
        <div class="sp-kv-row"><dt>Signals</dt><dd>{{#each exporter.signals}}{{> components/badge tone="accent" text=this}} {{/each}}</dd></div>
    </dl>
    {{/if}}

    {{#> components/section title="Signals" count=signal_count note="Every signal core can export, and whether the profile enables it."}}{{/components/section}}
    {{#> components/table caption="Export state per signal" modifier="sp-obs-signals"}}
        <thead><tr>
            <th>Signal</th>
            <th>State</th>
        </tr></thead>
        <tbody>
        {{#each signals}}
        <tr data-signal="{{signal}}">
            <td><strong>{{signal}}</strong></td>
            <td>{{#if enabled}}{{> components/badge tone="ok" text="enabled"}}{{else}}{{> components/badge tone="muted" text="off"}}{{/if}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{/inline}}
{{/layout}}
