{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle=subtitle}}
      {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance">Decisions</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance/approvals">Approvals</a>
        <a class="sp-btn sp-btn--sm sp-btn--primary" href="{{csv_url}}">Export CSV</a>
      {{/inline}}
      {{#*inline "header_meta"}}
        {{> components/time-range time_range}}
      {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Secret access summary">
      {{#each kpis}}
        {{> components/kpi label=this.label value=this.value note=this.sub
            tone=this.tone href=this.href active=this.active hint=this.hint}}
      {{/each}}
    </section>

    {{#> components/section title="Access trail" count=row_count}}
      {{#*inline "section_actions"}}
        {{#if has_filters}}<a class="sp-btn sp-btn--sm sp-btn--ghost" href="{{clear_url}}">Clear filters</a>{{/if}}
      {{/inline}}
    {{/components/section}}

    <form class="sp-toolbar" method="get" action="{{base_url}}">
      {{!-- The window is part of what the filters narrow, so the form has to
           carry it; a submit that dropped it would silently reset the range. --}}
      <input type="hidden" name="preset" value="{{time_range.preset}}">
      <input type="hidden" name="from" value="{{time_range.from}}">
      <input type="hidden" name="to" value="{{time_range.to}}">
      <label class="sp-toolbar__filter">
        <span class="sp-toolbar__filter-label">Action</span>
        <select class="sp-filter-select" name="action">
          {{#each actions}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </label>
      <label class="sp-toolbar__search">
        <span class="sp-u-sr-only">Search variable, plugin or person</span>
        <input class="sp-search-input" type="search" name="q" value="{{search}}"
               placeholder="Variable, plugin or person…">
      </label>
      <div class="sp-toolbar__actions">
        <button type="submit" class="sp-btn sp-btn--sm sp-btn--outline">Apply</button>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{csv_url}}">CSV</a>
      </div>
    </form>

    {{#> components/table caption="Secret audit log" pagination=pagination modifier="sp-t-secrets"}}
      <thead><tr>
        <th class="sp-col-date">When</th>
        <th class="sp-col-status">Action</th>
        <th class="sp-col-text">Variable</th>
        <th class="sp-col-text">Plugin</th>
        <th class="sp-col-identity">Owner</th>
        <th class="sp-col-identity">Actor</th>
        <th class="sp-col-text">Third party</th>
        <th class="sp-col-text">IP</th>
      </tr></thead>
      <tbody>
      {{#each rows}}
        <tr>
          <td class="sp-table__cell--date">{{this.created_at}}</td>
          <td>{{> components/badge tone=this.tone text=this.action}}</td>
          <td class="sp-table__cell--mono">{{this.var_name}}</td>
          <td class="sp-table__cell--muted">{{this.plugin_id}}</td>
          <td class="sp-table__cell--mono"><a class="sp-table__link" href="{{this.owner_url}}">{{this.owner}}</a></td>
          <td class="sp-table__cell--mono"><a class="sp-table__link" href="{{this.actor_url}}">{{this.actor}}</a></td>
          <td>{{#if this.third_party}}{{> components/badge tone="err" text="yes"}}{{else}}<span class="sp-u-text-muted">no</span>{{/if}}</td>
          <td class="sp-table__cell--muted">{{this.ip_address}}</td>
        </tr>
      {{/each}}
      {{#unless has_rows}}
        <tr class="sp-table__empty"><td colspan="8">
          {{> components/empty-state title="No secret activity"
              message="Nothing touched a stored credential in this window."}}
        </td></tr>
      {{/unless}}
      </tbody>
    {{/components/table}}
    {{/inline}}
{{/layout}}
