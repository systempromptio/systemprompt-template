{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=department.name subtitle=department.description}}
        {{#*inline "header_meta"}}
        <span class="sp-u-mono">{{department.id}}</span>
        <span>Created {{formatDate department.created_at}}</span>
        {{/inline}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{users_url}}">Roster</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{matrix_url}}">Access control</a>
        {{#if can_write}}
        <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="add-member">Add member</button>
        {{/if}}
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Department usage">
        {{> components/kpi label="Members" value=kpis.members note="accounts placed here"}}
        {{> components/kpi label="Requests" value=kpis.requests_display note="last 30 days"}}
        {{> components/kpi label="Tokens in" value=kpis.tokens_in_display note="last 30 days"}}
        {{> components/kpi label="Tokens out" value=kpis.tokens_out_display note="last 30 days"}}
        {{> components/kpi label="Cost" value=kpis.cost_display note="last 30 days"}}
    </section>

    {{> components/notice tone="info" title="Rules are inherited" message="Skills, marketplaces, plugins, MCP servers and gateway routes assigned to this department reach every member. A rule written on the account itself takes precedence. Renaming the department carries its rules with it."}}

    {{#if has_tools}}
    {{> components/section title="Top tools" note="The tools members called most in the last 30 days."}}
    <p class="sp-p-department-detail__tools">
        {{#each top_tools}}{{> components/badge tone="info" text=(concat this.tool_name " · " this.invocations)}}{{/each}}
    </p>
    {{/if}}

    {{> components/section title="Members" count=member_count note="Moving a member out returns them to Default."}}
    <div data-dept-id="{{department.id}}" data-dept-name="{{department.name}}">
    {{#if has_members}}
    {{#> components/table caption="Members of this department with their thirty-day usage" modifier="sp-p-department-detail__members"}}
        <thead><tr>
            <th scope="col">Email</th>
            <th scope="col">Name</th>
            <th scope="col" class="sp-col-status">Status</th>
            <th scope="col" class="sp-table__cell--num">Requests</th>
            <th scope="col" class="sp-table__cell--num">Tokens</th>
            <th scope="col" class="sp-table__cell--num">Cost</th>
            <th scope="col" class="sp-table__cell--date">Last active</th>
            <th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
        </tr></thead>
        <tbody>
        {{#each members}}
        <tr data-member-id="{{this.id}}">
            <td class="sp-u-truncate sp-u-mono" title="{{this.email}}"><a href="{{this.detail_url}}">{{this.email}}</a></td>
            <td class="sp-u-truncate" title="{{this.display_name}}">{{#if this.display_name}}{{this.display_name}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-col-status">{{> components/badge tone=this.status_tone text=this.status}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.requests_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.tokens_display}}</td>
            <td class="sp-table__cell--num sp-u-num sp-u-mono">{{this.cost_display}}</td>
            <td class="sp-table__cell--date" title="{{this.last_active_title}}">{{this.last_active}}</td>
            <td class="sp-table__cell--actions">
                {{#if ../can_write}}{{#unless ../is_default}}<button type="button" class="sp-p-departments__action" data-unassign-user="{{this.id}}">Move to Default</button>{{/unless}}{{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No members" message="No account is placed in this department yet. Add one by id, or move accounts here from their detail pages."}}
    {{/if}}
    </div>

    {{#if can_write}}
    <dialog class="sp-dialog" data-dialog="member-add" aria-labelledby="member-add-title">
        <form class="sp-dialog-form" data-form="member-add">
            <h3 id="member-add-title">Add member to {{department.name}}</h3>
            <label>User ID<input type="text" name="user_id" required placeholder="The account id" autocomplete="off"></label>
            <p class="sp-u-text-muted">The account moves into {{department.name}} and leaves the department it is in now.</p>
            <p class="sp-u-text-danger" data-error hidden></p>
            <menu>
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="dialog-close">Cancel</button>
                <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Add</button>
            </menu>
        </form>
    </dialog>

    {{#unless is_default}}
    {{> components/section title="Settings" note="Rename or describe the department. Deleting it moves every member to Default and removes its rules."}}
    <form class="sp-p-department-detail__settings" data-form="dept-settings" data-dept-id="{{department.id}}" data-dept-name="{{department.name}}">
        <div class="sp-form-group">
            <label for="dept-settings-name">Name</label>
            <input class="sp-field-input" id="dept-settings-name" type="text" name="name" value="{{department.name}}" required maxlength="64">
        </div>
        <div class="sp-form-group">
            <label for="dept-settings-description">Description</label>
            <textarea class="sp-field-input" id="dept-settings-description" name="description" rows="3">{{department.description}}</textarea>
        </div>
        <div class="sp-form-actions">
            <button type="submit" class="sp-btn sp-btn--primary">Save</button>
            <button type="button" class="sp-btn sp-btn--danger" data-action="delete-department">Delete department</button>
            <span class="sp-form-status" data-status role="status"></span>
        </div>
    </form>
    {{/unless}}
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/management-department-detail.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
