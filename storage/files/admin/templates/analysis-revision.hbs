{{#> layout}}{{#*inline "content"}}
{{> components/page-header title=title subtitle="Verified stored bytes and provenance for this revision."}}
<p><a href="/admin/analysis/versions">All marketplace versions</a></p>
<dl><dt>Revision</dt><dd>{{id}}</dd><dt>Source snapshot</dt><dd>{{manifest.snapshot_id}}</dd>{{#if manifest.parent_id}}<dt>Parent</dt><dd><a href="/admin/analysis/revisions/{{manifest.parent_id}}">{{manifest.parent_id}}</a></dd>{{/if}}</dl>
{{#each files}}<section class="sp-analysis-definitions"><h2>{{path}}</h2><p>{{bytes}} bytes · <code>{{digest}}</code></p>{{#if text}}<pre class="sp-analysis-file-preview"><code>{{text}}</code></pre>{{else}}<p>No text preview for this file.</p>{{/if}}{{#if truncated}}<p>Preview truncated; the stored revision retains the complete file.</p>{{/if}}</section>{{/each}}
{{/inline}}{{/layout}}
