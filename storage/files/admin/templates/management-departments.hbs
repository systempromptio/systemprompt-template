{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Org units that group accounts. A department carries access rules its members inherit, and its usage rolls up from theirs."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/access-control">Access control</a>
        {{#if can_write}}
        <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="new-department">New department</button>
        {{/if}}
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Department totals">
        {{> components/kpi label="Departments" value=kpis.departments note="including Default"}}
        {{> components/kpi label="Members" value=kpis.members note="accounts placed"}}
        {{> components/kpi label="Requests" value=kpis.requests_display note="last 30 days"}}
        {{> components/kpi label="Tokens" value=kpis.tokens_display note="in + out, 30 days"}}
        {{> components/kpi label="Cost" value=kpis.cost_display note="last 30 days"}}
    </section>

    {{#> components/section title="Departments" count=total note="Usage columns cover the last 30 days."}}
        {{#*inline "section_actions"}}
        {{#if filters_applied}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{clear_url}}">Clear search</a>{{/if}}
        {{/inline}}
    {{/components/section}}

    <form class="sp-toolbar" method="get" action="/admin/departments" role="search" aria-label="Search departments">
        <span class="sp-toolbar__count">{{total}} departments</span>
        <label class="sp-u-sr-only" for="departments-filter-q">Search departments</label>
        <div class="sp-toolbar__search">
            <input class="sp-search-input" id="departments-filter-q" type="search" name="q" value="{{search}}" placeholder="Name or description">
        </div>
        <div class="sp-toolbar__actions">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--secondary">Apply</button>
        </div>
    </form>

    {{#if has_rows}}
    {{#> components/table caption="Every department with its membership and thirty-day usage" modifier="sp-p-departments__table"}}
        <thead><tr>
            {{#each sort_headers}}{{> components/sort-header this}}{{/each}}
            <th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
        </tr></thead>
        <tbody>
        {{#each rows}}
        <tr data-dept-id="{{this.id}}">
            <td><a href="{{this.detail_url}}">{{this.name}}</a></td>
            <td class="sp-u-truncate sp-table__cell--muted" title="{{this.description}}">{{#if this.description}}{{this.description}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.member_count}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.assignment_count}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.requests_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.tokens_display}}</td>
            <td class="sp-table__cell--num sp-u-num sp-u-mono">{{this.cost_display}}</td>
            <td class="sp-table__cell--actions">
                <a class="sp-p-departments__action" href="{{this.detail_url}}">Open</a>
                {{#if ../can_write}}{{#if this.deletable}}<button type="button" class="sp-p-departments__action sp-p-departments__action--danger" data-delete-dept="{{this.id}}" data-dept-name="{{this.name}}">Delete</button>{{/if}}{{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No departments match" message="No department matches that search. Clear it to see every department, or create one."}}
    {{/if}}

    {{#if can_write}}
    <dialog class="sp-dialog" data-dialog="dept-create" aria-labelledby="dept-create-title">
        <form class="sp-dialog-form" data-form="dept-create">
            <h3 id="dept-create-title">New department</h3>
            <label>Name<input type="text" name="name" required maxlength="64" autocomplete="off" placeholder="e.g. Engineering"></label>
            <label>Description<textarea name="description" rows="2" placeholder="Optional"></textarea></label>
            <p class="sp-u-text-danger" data-error hidden></p>
            <menu>
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="dialog-close">Cancel</button>
                <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Create</button>
            </menu>
        </form>
    </dialog>
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/management-departments.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
