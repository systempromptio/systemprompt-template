{{!--
  Admin navigation, rendered from the console dashboard
  (`services/web/config/dashboard.yaml`, overridable per flavour): one
  collapsible group per configured section, each item a page this build
  compiles. A section a non-console viewer has no item in is not drawn.

  Exactly one group is always open: the one holding the current page. It has
  no chevron and its toggle is a no-op. Before JS runs, CSS opens it with
  `:has(.is-active, .is-ancestor)`; `services/nav-groups.js` then owns the
  state and remembers which other groups the reader opened. Each section
  carries a `sp-nav-group--<id>` modifier that keys its hue, so reordering
  groups never recolours a neighbour.

  Active state: every link goes through the `nav-item` partial, which marks
  the active leaf and draws the expanded ancestor and the open record
  beneath it. `/admin` and `/admin/analytics` render the same page id, so
  `services/sidebar.js` corrects the pair from the exact pathname once JS is
  up.
--}}
<aside class="sp-admin-sidebar" id="sp-admin-sidebar">
    <button class="sp-sidebar-close-btn" type="button" aria-label="Close menu">&times;</button>
    <a href="/admin" class="sp-admin-sidebar-brand" aria-label="{{default branding.domain "systemprompt.io"}} - Go to admin">
        <img src="{{default branding.logo_light "/files/images/logo.svg"}}" alt="{{default branding.domain "systemprompt.io"}}" class="sp-admin-logo sp-admin-logo--light" />
        <img src="{{default branding.logo_dark "/files/images/logo-white.svg"}}" alt="{{default branding.domain "systemprompt.io"}}" class="sp-admin-logo sp-admin-logo--dark" />
    </a>
    <nav aria-label="Admin navigation" data-nav>
        {{#each nav_sections}}
        <section class="sp-nav-group sp-nav-group--{{this.id}}" data-nav-group="{{this.id}}">
        <h2 class="sp-nav-label">
            <button class="sp-nav-group__toggle" type="button" data-action="nav-group-toggle" aria-expanded="false" aria-controls="sp-nav-group-{{this.id}}">
                <span class="sp-nav-group__title">{{this.label}}</span>
                <span class="sp-nav-group__count" data-nav-group-count aria-hidden="true"></span>
                <svg class="sp-nav-group__chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </h2>
        <div class="sp-nav-group__items" id="sp-nav-group-{{this.id}}">
        <div class="sp-nav-group__inner">
        {{#each this.items}}
        {{#if this.external}}
        <a href="{{this.href}}" target="_blank" rel="noopener noreferrer">
            {{{this.icon}}}
            {{this.text}}
            <span class="sp-nav-external" aria-hidden="true">↗</span>
        </a>
        {{else}}
        {{> nav-item item=this page=@root.page}}
        {{/if}}
        {{/each}}
        </div>
        </div>
        </section>
        {{/each}}
    </nav>

    <p class="sp-nav-version">v{{app_version}}</p>
</aside>
