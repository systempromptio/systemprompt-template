{{!--
  What the gateway did in this window. Kept separate from the quality band so
  a tab never mixes "how much traffic" with "how good were the answers".
--}}
<section class="sp-kpi-grid" aria-label="Traffic KPIs">
    {{#if traffic.has_distribution}}
    {{> components/kpi label="Requests" value=traffic.total tone="accent" note=(concat traffic.user_count " users · " traffic.model_count " models")}}
    {{else}}
    {{> components/kpi label="Requests" value=traffic.total tone="accent" note="through the gateway in this window"}}
    {{/if}}
    {{> components/kpi label="p50 latency" value=traffic.p50_latency_ms unit="ms" note=(concat "p95 " traffic.p95_latency_ms " ms")}}
    {{> components/kpi label="Traffic cost" value=traffic.total_cost_display note=(concat "judging " scores.judge_cost_display)}}
    {{#if traffic.error_count}}
    {{> components/kpi label="Errors" value=traffic.error_count tone="err" note=(concat traffic.error_rate_pct "% of requests")}}
    {{else}}
    {{> components/kpi label="Errors" value=traffic.error_count tone="ok" note="none in this window"}}
    {{/if}}
</section>
