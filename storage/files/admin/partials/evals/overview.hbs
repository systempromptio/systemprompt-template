{{!--
  Overview tab: every eval run in the window regardless of kind, then the
  shape of the traffic. The table leads because it is what the tab is about;
  the charts sit below it where they cannot push it under the fold.
--}}
{{> components/section title="Recent runs" note="Every evaluation launched in this window. Open a run to see the items it scored."}}
{{#if runs}}
{{> evals/runs-table runs=runs}}
{{else}}
{{> components/empty-state title="No evaluations yet"
    message="No evaluation has run in this window. Start one from the Judge, Head-to-head, or Golden set tab."}}
{{/if}}

<div class="sp-p-evals__charts">
    <section class="sp-card sp-p-evals__chart" aria-label="Latency distribution">
        <div class="sp-card__body">
            <h2 class="sp-section__title">Latency distribution</h2>
            {{> components/latency-histogram histogram}}
        </div>
    </section>
    <section class="sp-card sp-p-evals__chart" aria-label="Cost over time">
        <div class="sp-card__body">
            {{> components/timeseries-chart cost_chart}}
        </div>
    </section>
</div>
