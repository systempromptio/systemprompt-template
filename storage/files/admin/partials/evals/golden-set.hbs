{{!--
  Golden set tab: the fixed cases, the replay that re-runs them against a model,
  and the replay runs already done.
--}}
{{> components/section title="Replay the golden set" note="A replay sends every case to the target model and scores the fresh answers against the same rubric. Judge calls go out through this gateway under your own session, so they are scope-checked, audited and costed like any other client's traffic."}}

<div class="sp-card">
    <form method="post" action="{{base_url}}/run" class="sp-card__body sp-p-evals__run-form">
        <input type="hidden" name="kind" value="replay">
        <input type="hidden" name="tab" value="{{tab}}">
        <input type="hidden" name="from" value="{{time_range.from}}">
        <input type="hidden" name="to" value="{{time_range.to}}">
        <div class="sp-form-group">
            <label for="evals-replay-model">Target model</label>
            <select id="evals-replay-model" name="model" class="sp-select">
                {{#each model_options}}
                <option value="{{this.value}}">{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="sp-form-group">
            <label for="evals-replay-judge">Judge model</label>
            <select id="evals-replay-judge" name="judge_model" class="sp-select">
                {{#each model_options}}
                <option value="{{this.value}}">{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="sp-form-actions">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary"{{#unless cases}} disabled{{/unless}}>Run replay</button>
        </div>
    </form>
</div>

{{> components/section title="Cases" note="Every prompt promoted from a judged answer, with the model that answered it at the time."}}
{{#if cases}}
{{#> components/table caption="Golden-set cases" modifier="sp-p-evals__cases"}}
    <thead><tr>
        <th scope="col">Case</th>
        <th scope="col">Baseline model</th>
        <th scope="col">Expectation</th>
        <th scope="col" class="sp-table__cell--date">Added</th>
    </tr></thead>
    <tbody>
    {{#each cases}}
    <tr>
        <td class="sp-table__cell--primary sp-p-evals__clip" title="{{this.name}}">{{this.name}}</td>
        <td class="sp-table__cell--mono sp-p-evals__clip" title="{{this.baseline_model}}">{{this.baseline_model}}</td>
        <td class="sp-p-evals__clip" title="{{this.expectation}}">{{#if this.has_expectation}}{{this.expectation}}{{else}}<span class="sp-table__cell--muted">—</span>{{/if}}</td>
        <td class="sp-table__cell--date">{{this.created_at_local}}</td>
    </tr>
    {{/each}}
    </tbody>
{{/components/table}}
{{else}}
{{> components/empty-state title="The golden set is empty" message="Add a case from any judged answer on the Judge tab."}}
{{/if}}

{{> components/section title="Replay runs" note="Replays launched in this window. Open one to see every case it scored."}}
{{#if runs}}
{{> evals/runs-table runs=runs}}
{{else}}
{{> components/empty-state message="No replay has run in this window."}}
{{/if}}
