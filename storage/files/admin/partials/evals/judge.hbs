{{!--
  Judge tab: the scored answers first, worst verdicts on top, then the judge
  runs that produced them, then the form that launches the next one. The
  table leads so it sits above the fold under the tab strip and time range;
  the scores themselves are in the page header's meta line.
--}}
<form class="sp-toolbar" method="get" action="{{base_url}}" role="search" aria-label="Filter scored answers">
    <input type="hidden" name="tab" value="{{tab}}">
    <input type="hidden" name="preset" value="{{time_range.preset}}">
    <input type="hidden" name="from" value="{{time_range.from}}">
    <input type="hidden" name="to" value="{{time_range.to}}">
    <span class="sp-toolbar__count">{{scores.scored_count}} judged</span>
    <div class="sp-toolbar__field">
        <label class="sp-toolbar__field-label" for="evals-filter-verdict">Verdict</label>
        <select class="sp-select" id="evals-filter-verdict" name="verdict">
            {{#each filter.verdict_options}}
            <option value="{{this.value}}"{{#if this.is_selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="sp-toolbar__field">
        <label class="sp-toolbar__field-label" for="evals-filter-model">Model</label>
        <select class="sp-select" id="evals-filter-model" name="model">
            {{#each filter.model_options}}
            <option value="{{this.value}}"{{#if this.is_selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>
    <div class="sp-toolbar__actions">
        {{#if filter.is_filtered}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{base_url}}?tab={{tab}}&preset={{time_range.preset}}">Clear</a>
        {{/if}}
        <button type="submit" class="sp-btn sp-btn--sm sp-btn--secondary">Apply</button>
    </div>
</form>

{{#if results}}
{{> evals/results-table results=results}}
{{else}}
{{#if filter.is_filtered}}
{{> components/empty-state title="No match" message="No scored answers match this filter. Widen the verdict or model above."}}
{{else}}
{{> components/empty-state title="Nothing judged yet" message="Nothing judged in this window yet. Run a judge evaluation below to score recent traffic."}}
{{/if}}
{{/if}}

{{> components/section title="Judge runs" note="Every judge evaluation launched in this window. Open a run to see the answers it scored."}}
{{#if runs}}
{{> evals/runs-table runs=runs}}
{{else}}
{{> components/empty-state title="No judge runs yet" message="No judge evaluation has run in this window. Launch one below."}}
{{/if}}

{{#> components/section title="Judge live traffic" note="Judge calls go out through this gateway under your own session, so they are scope-checked, audited and costed like any other client's traffic, and are excluded from future sampling."}}
    {{#*inline "section_actions"}}
    <span class="sp-u-text-xs sp-u-text-tertiary">Suggested judge: <code class="sp-code-inline">{{judge_model}}</code>, the least-used model in this window</span>
    {{/inline}}
{{/components/section}}

<div class="sp-card">
    <form method="post" action="{{base_url}}/run" class="sp-card__body sp-p-evals__run-form">
        <input type="hidden" name="kind" value="judge">
        <input type="hidden" name="tab" value="{{tab}}">
        <input type="hidden" name="from" value="{{time_range.from}}">
        <input type="hidden" name="to" value="{{time_range.to}}">
        <div class="sp-form-group">
            <label for="evals-sample-size">Sample size</label>
            <input type="number" id="evals-sample-size" name="sample_size" class="sp-field-input"
                   value="{{default_sample_size}}" min="1" max="{{max_sample_size}}">
        </div>
        <div class="sp-form-group">
            <label for="evals-judge-model">Judge model</label>
            <select id="evals-judge-model" name="judge_model" class="sp-select">
                {{#each model_options}}
                <option value="{{this.value}}">{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="sp-form-actions">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary"{{#unless model_options}} disabled{{/unless}}>Run judge</button>
        </div>
    </form>
</div>
