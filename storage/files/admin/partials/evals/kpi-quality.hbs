{{!--
  What the judge made of the traffic. Shown on the tabs that are about scores.
--}}
<section class="sp-kpi-grid" aria-label="Judged quality KPIs">
    {{> components/kpi label="Mean score" value=scores.mean_score_display unit="/ 5" tone="accent" note=(concat scores.scored_count " answers judged")}}
    {{> components/kpi label="Pass" value=scores.pass_count tone="ok" note="verdict pass"}}
    {{> components/kpi label="Partial" value=scores.partial_count tone="warn" note="verdict partial"}}
    {{#if scores.fail_count}}
    {{> components/kpi label="Fail" value=scores.fail_count tone="err" note=(concat scores.flagged_count " flagged")}}
    {{else}}
    {{> components/kpi label="Fail" value=scores.fail_count tone="ok" note="no failing answers"}}
    {{/if}}
    {{> components/kpi label="Coverage" value=scores.coverage_pct unit="%" note=(concat "of " traffic.total " requests · judging " scores.judge_cost_display)}}
</section>
