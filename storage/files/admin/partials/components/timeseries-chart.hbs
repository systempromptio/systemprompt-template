{{!--
  Vertical bar chart over time, CSS-only.

  Invoke as: {{> components/timeseries-chart cost_chart}}
  The partial's root context is the chart object itself.

  The plot is a grid: a y-axis gutter carrying the max / mid / zero labels, and
  a plot area whose bars grow from a baseline. Every label is precomputed by
  the view layer, so the template does no arithmetic and the axis can never
  disagree with the bars it is labelling.

  Inputs (fields on the passed context):
    title / subtitle    heading and the one-line summary under it
    tone                accent | success — picks the bar colour
    series              [{pct, tooltip}]
    has_data            false when every bucket is zero
    y_max_display       top gridline label
    y_mid_display       middle gridline label
    x_start/mid/end_display   time axis labels
    empty_message       shown instead of the plot when has_data is false
--}}
<figure class="sp-timeseries" data-tone="{{tone}}">
    <figcaption class="sp-timeseries__head">
        <span class="sp-timeseries__title">{{chart_title}}</span>
        <span class="sp-timeseries__subtitle">{{subtitle}}</span>
    </figcaption>
    {{#if has_data}}
    <div class="sp-timeseries__plot">
        <div class="sp-timeseries__y-axis" aria-hidden="true">
            <span>{{y_max_display}}</span>
            <span>{{y_mid_display}}</span>
            <span>0</span>
        </div>
        <div class="sp-timeseries__bars" role="img"
             aria-label="{{chart_title}} from {{x_start_display}} to {{x_end_display}}, peak {{y_max_display}}">
            {{#each series}}
            <span class="sp-timeseries__bar" style="--v:{{this.pct}}%" title="{{this.tooltip}}"></span>
            {{/each}}
        </div>
    </div>
    <div class="sp-timeseries__x-axis" aria-hidden="true">
        <span>{{x_start_display}}</span>
        <span>{{x_mid_display}}</span>
        <span>{{x_end_display}}</span>
    </div>
    {{else}}
    <p class="sp-empty">{{empty_message}}</p>
    {{/if}}
</figure>
