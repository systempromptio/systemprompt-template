{{!-- {{> components/badge-stack items=list stack_max=1 stack_tone="info" stack_label="Models"}} — items: strings, or {label, tone, href}. The first stack_max show; the rest sit stacked behind a +N pill and fan out on hover or focus. Hash keys are prefixed because a partial hash shadows item fields at every depth. --}}
{{#if items}}<span class="sp-badge-stack{{#if stack_mono}} sp-badge-stack--mono{{/if}}" tabindex="0" aria-label="{{stack_label}}: {{#each items}}{{#if this.label}}{{this.label}}{{else}}{{this}}{{/if}}{{#unless @last}}, {{/unless}}{{/each}}"><span class="sp-badge-stack__row">{{#each items}}{{#unless (gt @index (sub stack_max 1))}}{{#if this.href}}<a class="sp-badge sp-badge--nodot sp-badge--{{#if this.tone}}{{this.tone}}{{else}}{{stack_tone}}{{/if}} sp-badge-stack__item" href="{{this.href}}">{{this.label}}</a>{{else}}<span class="sp-badge sp-badge--nodot sp-badge--{{#if this.tone}}{{this.tone}}{{else}}{{stack_tone}}{{/if}} sp-badge-stack__item">{{#if this.label}}{{this.label}}{{else}}{{this}}{{/if}}</span>{{/if}}{{/unless}}{{#if @last}}{{#if (gt @index (sub stack_max 1))}}<span class="sp-badge-stack__more" aria-hidden="true">+{{sub @index (sub stack_max 1)}}</span>{{/if}}{{/if}}{{/each}}</span><ul class="sp-badge-stack__pop" role="list">{{#each items}}<li>{{#if this.href}}<a class="sp-badge sp-badge--nodot sp-badge--{{#if this.tone}}{{this.tone}}{{else}}{{stack_tone}}{{/if}}" href="{{this.href}}">{{this.label}}</a>{{else}}<span class="sp-badge sp-badge--nodot sp-badge--{{#if this.tone}}{{this.tone}}{{else}}{{stack_tone}}{{/if}}">{{#if this.label}}{{this.label}}{{else}}{{this}}{{/if}}</span>{{/if}}</li>{{/each}}</ul></span>{{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
