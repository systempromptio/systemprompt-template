{{!--
  Breadcrumb trail. Invoke as: {{> components/breadcrumbs crumbs=breadcrumbs}}
  crumbs: array of {label, href?} — last item is the current page (no href).
--}}
<nav class="sp-breadcrumbs" aria-label="Breadcrumb">
    {{#each crumbs}}
        {{#if @first}}{{else}}<span class="sp-breadcrumbs__sep" aria-hidden="true">›</span>{{/if}}
        {{#if this.href}}
            <a href="{{this.href}}">{{this.label}}</a>
        {{else}}
            <span aria-current="page">{{this.label}}</span>
        {{/if}}
    {{/each}}
</nav>
