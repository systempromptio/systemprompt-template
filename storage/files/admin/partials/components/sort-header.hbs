{{!--
  One sortable column header. Invoke with the header object itself:
    {{> components/sort-header sort_headers.started}}
  Inputs: label, class (column class), url, active, aria_sort, indicator, hint.
  `hint` explains the column on the header, where no row overlay can cover it.
--}}
<th class="{{class}}{{#if active}} is-sorted{{/if}}" aria-sort="{{aria_sort}}"{{#if hint}} title="{{hint}}"{{/if}}>
  <a class="sp-table__sort" href="{{url}}">{{label}}<span class="sp-table__sort-icon" aria-hidden="true">{{indicator}}</span></a>
</th>
