{{!--
  One breakdown tab's table: traffic, spend, latency, and failures grouped by
  model, provider, or status.

  Invoke as: {{> components/breakdown-table breakdown}}
  The partial's root context is the breakdown object itself, so the three tabs
  share one markup and cannot drift apart.

  Every row is a link into the Log tab pre-filtered to that row, which is how
  the page filters — there are no filter dropdowns.

  Inputs (fields on the passed context):
    dimension_label   column heading for the grouping key
    caption           one line explaining what the table answers
    has_rows          false when the window has nothing to group
    rows              [{key, requests, share_pct, share_display, tokens_display,
                        cost_display, p50_display, p95_display, error_count,
                        error_rate_display, has_errors, filter_url}]
--}}
<p class="sp-section__sub">{{caption}}</p>

{{#if has_rows}}
{{#> components/table}}
    <thead><tr>
        <th>{{dimension_label}}</th>
        <th class="sp-col-share">Share</th>
        <th class="sp-table__cell--num">Requests</th>
        <th class="sp-table__cell--num">Tokens in / out</th>
        <th class="sp-table__cell--num">Cost</th>
        <th class="sp-table__cell--num">p50</th>
        <th class="sp-table__cell--num">p95</th>
        <th class="sp-table__cell--num">Errors</th>
    </tr></thead>
    <tbody>
    {{#each rows}}
    <tr class="sp-breakdown-row{{#if this.has_errors}} sp-breakdown-row--errors{{/if}}">
        <td>
            <a class="sp-breakdown-row__key" href="{{this.filter_url}}"
               title="Show these calls in the log">
                <code class="sp-code-inline">{{this.key}}</code>
            </a>
        </td>
        <td class="sp-col-share">
            <span class="sp-share-bar" style="--v:{{this.share_pct}}%"
                  aria-hidden="true"></span>
            <span class="sp-share-bar__value">{{this.share_display}}</span>
        </td>
        <td class="sp-table__cell--num">{{this.requests}}</td>
        <td class="sp-table__cell--num">{{this.tokens_display}}</td>
        <td class="sp-table__cell--num">{{this.cost_display}}</td>
        <td class="sp-table__cell--num">{{this.p50_display}}</td>
        <td class="sp-table__cell--num">{{this.p95_display}}</td>
        <td class="sp-table__cell--num">
            {{#if this.has_errors}}
              <span class="sp-badge sp-badge--err">{{this.error_count}} · {{this.error_rate_display}}</span>
            {{else}}
              <span class="sp-u-text-muted">none</span>
            {{/if}}
        </td>
    </tr>
    {{/each}}
    </tbody>
{{/components/table}}
{{else}}
{{> components/empty-state
    message="Nothing to group in this window. Widen the time range or run a demo to populate data."}}
{{/if}}
