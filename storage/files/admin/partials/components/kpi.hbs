{{!--
  One KPI tile. Pass `href` to make the tile the filter its number describes;
  `active` marks that filter as applied. `tone` is ok | warn | err | info | accent and
  paints the inline-start bar only. `icon` names a components/icon glyph drawn
  before the label; `spark` is a SparklineView drawn in a reserved trend row
  between the value and the note — part of the flow, so the trend can never
  sit over the number or squeeze the label.

  The supporting line is `note`, not `sub` and not `subtitle`: `sub` is a
  registered helper, so a bare `sub` mustache called it with no arguments and
  printed 0 on every tile, and `subtitle` resolved to the page's own subtitle.
  A field genuinely named `sub` must be read as `this.sub`, which is a path and
  cannot be mistaken for a helper.

    {{> components/kpi label="Denied" value=denied tone="err" icon="shield"
        unit="calls" note="of 1,204 in window" href=denied_url spark=denied_spark}}
--}}
{{#if href}}
<a class="sp-kpi sp-kpi--link{{#if tone}} sp-kpi--{{tone}}{{/if}}{{#if active}} is-active{{/if}}"
   href="{{href}}"{{#if hint}} title="{{hint}}"{{/if}}>
{{else}}
<div class="sp-kpi{{#if tone}} sp-kpi--{{tone}}{{/if}}"{{#if hint}} title="{{hint}}"{{/if}}>
{{/if}}
    <div class="sp-kpi__body">
    <span class="sp-kpi__label">{{#if icon}}{{> components/icon name=icon}}{{/if}}{{label}}</span>
    <span class="sp-kpi__value">{{value}}{{#if unit}}<span class="sp-kpi__unit">{{unit}}</span>{{/if}}</span>
    {{#if spark}}<div class="sp-kpi__trend">{{> components/sparkline spark}}</div>{{/if}}
    {{#if note}}<span class="sp-kpi__sub">{{note}}</span>{{/if}}
    {{#if delta}}<span class="sp-delta{{#if delta_dir}} sp-delta--{{delta_dir}}{{/if}}">{{delta}}</span>{{/if}}
    </div>
{{#if href}}</a>{{else}}</div>{{/if}}
