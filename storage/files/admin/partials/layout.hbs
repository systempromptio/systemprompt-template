<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{default branding.domain "systemprompt"}} Admin - {{title}}</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
    {{#> head_extra}}{{/head_extra}}
</head>
<body>
    <a href="#main" class="sp-skip-link">Skip to main content</a>
    <div class="sp-shell" data-section="{{page}}">
        {{> sidebar page=page}}
        <div class="sp-sidebar-overlay" id="sp-sidebar-overlay" aria-hidden="true"></div>
        <main class="sp-shell__main" id="main">
            <header class="sp-topbar" role="banner">
                <button class="sp-topbar__nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sp-admin-sidebar">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <rect x="2" y="4" width="16" height="2" rx="1"/>
                        <rect x="2" y="9" width="16" height="2" rx="1"/>
                        <rect x="2" y="14" width="16" height="2" rx="1"/>
                    </svg>
                </button>
                <form class="sp-topbar__search" role="search" id="admin-header-search-form" autocomplete="off">
                    <svg class="sp-topbar__search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <circle cx="7" cy="7" r="5"/>
                        <path d="M11 11l3 3" stroke-linecap="round"/>
                    </svg>
                    <input type="search" name="q" id="admin-header-search-input" class="sp-topbar__search-input"
                           placeholder="Paste a session, context, trace, or request ID…"
                           autocomplete="off" spellcheck="false"
                           aria-label="Jump to a trace or request by ID" />
                    <kbd class="sp-topbar__search-hint" aria-hidden="true">↵</kbd>
                    <span class="sp-topbar__search-status" id="admin-header-search-status" role="status" aria-live="polite"></span>
                </form>
                <div class="sp-topbar__spacer"></div>
                <div class="sp-topbar__actions" id="header-actions">
                    <button class="sp-topbar__actions-toggle" type="button" aria-label="Actions menu" aria-expanded="false" aria-haspopup="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/>
                        </svg>
                    </button>
                    <div class="sp-topbar__actions-menu">
                        {{#if demo_help_url}}
                        <a href="{{demo_help_url}}" target="_blank" rel="noopener noreferrer" class="sp-topbar__help" title="Help for this page" aria-label="Help for {{title}}">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 9a3.5 3.5 0 116 2c0 1.5-2 2.5-3 3"/>
                                <line x1="12" y1="18.5" x2="12.01" y2="18.5"/>
                            </svg>
                        </a>
                        {{/if}}
                        {{> components/install-widget}}
                        <div class="sp-user-widget-row">
                            <a href="/admin/profile" class="sp-user-widget" id="user-profile" title="Profile">
                                <div class="sp-avatar" id="user-avatar">{{initials current_user.username}}</div>
                            </a>
                            <button type="button" id="btn-logout" class="sp-btn--logout" title="Sign out" aria-label="Sign out">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </header>
            <div class="sp-notice-region" id="global-limit-warnings" hidden></div>
            {{#if scope_selector}}{{> components/scope-selector}}{{/if}}
            {{> content}}
            {{> components/admin-footer}}
        </main>
    </div>
    {{> components/chain-drawer}}
<script data-cfasync="false" type="module" src="/js/services/bootstrap.js?v={{css_version}}" defer></script>
    {{#> scripts}}{{/scripts}}
</body>
</html>
