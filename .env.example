# At least one of these is required.
# Identifies the platform admin on sign-in and consent screens.
# Required on first boot; must be an address you control.
ADMIN_EMAIL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional — auto-generated on first boot if left blank.
JWT_SECRET=

# Optional — defaults shown.
HTTP_PORT=8080
PG_PORT=5432
POSTGRES_PASSWORD=systemprompt
