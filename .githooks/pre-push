#!/usr/bin/env bash
# Tracked pre-push hook. Enable with `just init-hooks` (sets core.hooksPath).
#
# Runs the static preflight tier only (fmt, sqlx cache freshness, the source
# gates) — seconds of shell and grep, no compilation. The lint tier's clippy
# run is a full workspace compile (a cold rebuild whenever [patch.crates-io]
# is toggled), which trained people to reach for --no-verify, so it stays out
# of the hook. `just preflight` before merging is still the mandatory gate;
# this repo has no CI behind it.
set -euo pipefail

echo "pre-push: running preflight-static (skip with --no-verify)"
just preflight-static
