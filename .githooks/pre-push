#!/usr/bin/env bash
# Tracked pre-push hook. Enable with `just init-hooks` (sets core.hooksPath).
#
# Runs the static preflight tier only (fmt, sqlx cache freshness, the source
# gates) — seconds of shell and grep, no compilation. The lint tier's clippy
# run is a full workspace compile (a cold rebuild whenever [patch.crates-io]
# is toggled), which trained people to reach for --no-verify, so it stays out
# of the hook. `just preflight` before merging is still the mandatory gate;
# this repo has no CI behind it.
set -euo pipefail

echo "pre-push: running preflight-static (skip with --no-verify)"
just preflight-static

# ── e2e, when and only when it can actually run ───────────────────────────────
# The Playwright suite needs a live stack, which is why it is in no gate and
# this repo has no CI — so an admin-web change could always land with the
# browser suite red. This closes that gap without reintroducing the cost that
# trained people to reach for --no-verify: the suite runs only when the push
# touches admin-web surfaces AND a healthy server is already up. It never
# starts a stack, and it never skips silently — a skip says which half was
# missing, so "it did not run" can't be mistaken for "it passed".
GATEWAY_URL="${GATEWAY_URL:-http://localhost:8080}"
WEB_PATHS='^(extensions/web/|storage/files/(css|js|admin)/|services/web/|playwright/)'

range_base="$(git merge-base @{push} HEAD 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || true)"
if [ -n "$range_base" ] && git diff --name-only "$range_base" HEAD | grep -qE "$WEB_PATHS"; then
    if curl -fsS -o /dev/null --max-time 3 "$GATEWAY_URL/health" 2>/dev/null; then
        echo "pre-push: admin-web files changed and $GATEWAY_URL is healthy — running e2e"
        just e2e
    else
        echo "pre-push: WARNING — admin-web files changed but no healthy server at" >&2
        echo "  $GATEWAY_URL, so the Playwright suite did NOT run. Before merging:" >&2
        echo "      just start   # then, in another shell" >&2
        echo "      just e2e-seed && just e2e" >&2
    fi
fi
